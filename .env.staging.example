# Copy to .env.staging on the server, set mode 0600, and replace every CHANGE_ME.
COMPOSE_PROJECT_NAME=fleetpilot-staging
STAGING_DOMAIN=alpha.example.com
APP_URL=https://alpha.example.com
CADDY_EMAIL=ops@example.com

# Release identity. The deployment script requires a full 40-character Git SHA.
APP_COMMIT_SHA=CHANGE_ME_FULL_GIT_SHA
FLEETPILOT_IMAGE_REPOSITORY=fleetpilot-staging

# PostgreSQL is reachable only on the internal Compose network.
POSTGRES_DB=fleetpilot_staging
POSTGRES_USER=fleetpilot
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://fleetpilot:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@db:5432/fleetpilot_staging?schema=public

# Auth.js / GitHub OAuth. Callback:
# https://alpha.example.com/api/auth/callback/github
AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
AUTH_GITHUB_ID=CHANGE_ME_GITHUB_OAUTH_CLIENT_ID
AUTH_GITHUB_SECRET=CHANGE_ME_GITHUB_OAUTH_CLIENT_SECRET
# Employee magic-link sign-in. Keep disabled until the staging sender is verified.
EMAIL_AUTH_ENABLED=false
EMAIL_AUTH_RESEND_API_KEY=
EMAIL_AUTH_FROM="FleetPilot Alpha <sign-in@alpha.example.com>"
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Optional read-only bank transaction provider. Leave all values empty to keep
# live connection and synchronization actions disabled. Generate the encryption
# key with: openssl rand -hex 32
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
BANK_TOKEN_ENCRYPTION_KEY=

# Must match the private_files mount in docker-compose.staging.yml.
PRIVATE_FILE_STORAGE_ROOT=/var/lib/fleetpilot/private

# One-time, manually invoked bootstrap. Use the verified primary email of the
# private Internal Alpha administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=FleetPilot Administrator
BOOTSTRAP_COMPANY_NAME=FleetPilot Internal Alpha

# Host-side encrypted backups.
BACKUP_DIR=/var/backups/fleetpilot
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
# Keep this identity file off-repository with mode 0600. It is used only for restore.
BACKUP_AGE_IDENTITY_FILE=/etc/fleetpilot/backup-age-key.txt
DEPLOY_STATE_DIR=/var/lib/fleetpilot/deployments
