generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TruckStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum CabType {
  DAYCAB
  SLEEPER
  OWNER_OP
}

enum DriverPayType {
  PERCENTAGE
  PER_MILE
  FLAT
}

enum LoadStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  dotNumber String?
  mcNumber  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trucks    Truck[]
  loads     Load[]
  bankAccounts BankAccount[]
}

model Truck {
  id          String      @id @default(cuid())
  unitNumber  String      @unique
  vin         String?
  year        Int?
  make        String?
  model       String?
  status      TruckStatus @default(ACTIVE)
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  cabType     CabType     @default(SLEEPER)
  isOwnerOp   Boolean     @default(false)
  ownerName   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  drivers          Driver[]
  loads            Load[]
  settlements      Settlement[]
  truckInspections TruckInspection[]
}

model Driver {
  id         String        @id @default(cuid())
  firstName  String
  lastName   String
  phone      String?
  email      String?
  licenseNum String?
  payType    DriverPayType @default(PERCENTAGE)
  payRate    Float
  truckId    String?
  truck      Truck?        @relation(fields: [truckId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  loads               Load[]
  settlements         Settlement[]
  driverOrientations  DriverOrientation[]
}

model Load {
  id           String     @id @default(cuid())
  loadNumber   String     @unique
  referenceNum String?
  status       LoadStatus @default(PENDING)
  origin       String
  destination  String
  pickupDate   DateTime?
  deliveryDate DateTime?
  miles        Float?
  rate         Float
  fuelSurcharge Float?    @default(0)
  truckId      String
  truck        Truck      @relation(fields: [truckId], references: [id])
  driverId     String?
  driver       Driver?    @relation(fields: [driverId], references: [id])
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  settlement   Settlement?
}

model Settlement {
  id              String    @id @default(cuid())
  weekEnding      DateTime
  truckId         String
  truck           Truck     @relation(fields: [truckId], references: [id])
  driverId        String?
  driver          Driver?   @relation(fields: [driverId], references: [id])
  loadId          String?   @unique
  load            Load?     @relation(fields: [loadId], references: [id])
  grossRevenue    Float
  driverPay       Float
  fuelDeduction   Float     @default(0)
  otherDeductions Float     @default(0)
  netPay          Float
  isPaid          Boolean   @default(false)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TruckInspection {
  id          String   @id @default(cuid())
  truckId     String
  truck       Truck    @relation(fields: [truckId], references: [id])
  inspectedBy String
  inspectedAt DateTime @default(now())
  phase1      Json
  phase2      Json
  phase3      Json
  currentMileage Int?
  notes       String?
  passed      Boolean  @default(true)
  photos      Json?
  createdAt   DateTime @default(now())
}

model BankAccount {
  id              String        @id @default(cuid())
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id])
  plaidItemId     String        @unique
  plaidAccessToken String
  institutionId   String?
  institutionName String?
  accounts        BankSubAccount[]
  transactions    BankTransaction[]
  lastSync        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BankSubAccount {
  id              String      @id @default(cuid())
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  plaidAccountId  String      @unique
  name            String
  officialName    String?
  type            String
  subtype         String?
  mask            String?
  currentBalance  Float?
  availableBalance Float?
  transactions    BankTransaction[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model BankTransaction {
  id              String       @id @default(cuid())
  bankAccountId   String
  bankAccount     BankAccount  @relation(fields: [bankAccountId], references: [id])
  subAccountId    String?
  subAccount      BankSubAccount? @relation(fields: [subAccountId], references: [id])
  plaidTransactionId String    @unique
  date            DateTime
  amount          Float
  name            String
  merchantName    String?
  category        String?
  subCategory     String?
  pending         Boolean      @default(false)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model EmailAccount {
  id          String   @id @default(cuid())
  email       String   @unique
  label       String
  password    String
  imapHost    String   @default("imap.gmail.com")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  emails      Email[]
}

model Email {
  id            String       @id @default(cuid())
  accountId     String
  account       EmailAccount @relation(fields: [accountId], references: [id])
  messageId     String
  from          String
  subject       String
  date          DateTime
  body          String       @db.Text
  isRead        Boolean      @default(false)
  isHandled     Boolean      @default(false)
  priority      String       @default("normal")
  category      String?
  createdAt     DateTime     @default(now())

  @@unique([accountId, messageId])
}

enum EmployeeRole {
  DISPATCHER
  ACCOUNTANT
  MANAGER
  ADMIN
  SAFETY
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Employee {
  id            String       @id @default(cuid())
  firstName     String
  lastName      String
  role          EmployeeRole @default(DISPATCHER)
  roleCustom    String?
  phone         String?
  email         String?
  country       String       @default("Turkmenistan")
  city          String?
  salary        Float?
  currency      String       @default("USD")
  paymentMethod String       @default("Bank Transfer")
  startDate     DateTime?
  isActive      Boolean      @default(true)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  payments      EmployeePayment[]
}

model EmployeePayment {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id])
  amount      Float
  currency    String        @default("USD")
  period      String        // e.g. "2026-04"
  method      String        @default("Bank Transfer")
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum TmFundTxType {
  DEPOSIT
  PAYMENT
  EXPENSE
  ADJUSTMENT
}

model TmFund {
  id           String         @id @default(cuid())
  name         String         @default("Turkmenistan Fund")
  balance      Float          @default(0)
  currency     String         @default("USD")
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  transactions TmFundTx[]
}

model TmFundTx {
  id          String       @id @default(cuid())
  fundId      String
  fund        TmFund       @relation(fields: [fundId], references: [id])
  type        TmFundTxType
  amount      Float
  description String
  employeeId  String?
  paymentRef  String?
  date        DateTime     @default(now())
  notes       String?
  createdAt   DateTime     @default(now())
}

model DriverOrientation {
  id          String   @id @default(cuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id])
  completedBy String
  completedAt DateTime @default(now())
  checklist   Json
  signature   String
  notes       String?
  createdAt   DateTime @default(now())
}
