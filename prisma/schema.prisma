model FinancialParty {
  id                         String                      @id @default(cuid())
  operatingGroupId           String
  companyId                  String?
  type                       FinancialPartyType
  name                       String
  externalReference          String?
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  operatingGroup             OperatingGroup              @relation(fields: [operatingGroupId], references: [id], onDelete: Cascade)
  company                    Company?                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transactionVendor          FinancialTransaction[]      @relation("FinancialTransactionVendor")
  transactionOwner           FinancialTransaction[]      @relation("FinancialTransactionOwner")
  allocations                FinancialAllocation[]
  expectationParties         FinancialExpectation[]
  adminFeeAgreements         AdminFeeAgreement[]
  bankTransactionAllocations BankTransactionAllocation[]
  bankCategorizationRules    BankCategorizationRule[]

  @@unique([operatingGroupId, type, name])
  @@index([companyId, type])
}

model FinancialTransaction {
  id                     String                         @id @default(cuid())
  operatingGroupId       String
  companyId              String?
  sourceId               String?
  destinationSourceId    String?
  transactionDate        DateTime
  amountMinor            BigInt
  currency               String                         @default("USD")
  direction              FinancialDirection
  description            String
  categoryId             String?
  vendorId               String?
  ownerId                String?
  customerId             String?
  status                 FinancialTransactionStatus     @default(DRAFT)
  reconciliationStatus   FinancialReconciliationStatus  @default(UNREVIEWED)
  dataStatus             FinancialDataStatus            @default(NORMALIZED)
  role                   FinancialTransactionRole       @default(ECONOMIC)
  memo                   String?
  reference              String?
  fingerprintSha256      String?
  recoverableFromOwner   Boolean                        @default(false)
  expectedRecoveryMinor  BigInt                         @default(0)
  recoveredAmountMinor   BigInt                         @default(0)
  waivedAmountMinor      BigInt                         @default(0)
  recoveryStatus         FinancialRecoveryStatus        @default(NOT_APPLICABLE)
  recoveryNotes          String?
  lastRecoveryAt         DateTime?
  waivedAt               DateTime?
  waivedByUserId         String?
  createdByUserId        String
  reviewedByUserId       String?
  reviewedAt             DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  operatingGroup         OperatingGroup                 @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  company                Company?                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  source                 FinancialSource?               @relation("FinancialTransactionSource", fields: [sourceId], references: [id], onDelete: Restrict)
  destinationSource      FinancialSource?               @relation("FinancialTransactionDestination", fields: [destinationSourceId], references: [id], onDelete: Restrict)
  category               FinancialCategory?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor                 FinancialParty?                @relation("FinancialTransactionVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  owner                  FinancialParty?                @relation("FinancialTransactionOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  customer               Customer?                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy              User                           @relation("FinancialTransactionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy             User?                          @relation("FinancialTransactionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  waivedBy               User?                          @relation("FinancialTransactionWaiver", fields: [waivedByUserId], references: [id], onDelete: Restrict)
  evidence               FinancialTransactionEvidence[]
  allocations            FinancialAllocation[]
  expectationMatches     FinancialExpectationMatch[]
  auditEvents            FinancialAuditEvent[]
  pilotFuelingEvent      PilotFuelingEvent?
  pilotInvoiceAdjustment PilotInvoiceAdjustment?

  @@index([operatingGroupId, transactionDate])
  @@index([companyId, transactionDate])
  @@index([destinationSourceId, transactionDate])
  @@index([reconciliationStatus, transactionDate])
  @@index([categoryId, transactionDate])
  @@index([fingerprintSha256])
}

model FinancialTransactionEvidence {
  id                    String                @id @default(cuid())
  transactionId         String
  importRecordId        String
  matchedAmountMinor    BigInt
  method                FinancialMatchMethod
  role                  FinancialEvidenceRole @default(PRIMARY)
  confidenceBasisPoints Int?
  matchedByUserId       String
  matchedAt             DateTime              @default(now())
  transaction           FinancialTransaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  importRecord          FinancialImportRecord @relation(fields: [importRecordId], references: [id], onDelete: Restrict)
  matchedBy             User                  @relation("FinancialEvidenceMatcher", fields: [matchedByUserId], references: [id], onDelete: Restrict)

  @@unique([transactionId, importRecordId])
  @@index([importRecordId, matchedAt])
  @@index([transactionId, matchedAt])
}

model FinancialAllocation {
  id                 String                  @id @default(cuid())
  transactionId      String
  amountMinor        BigInt
  categoryId         String
  companyId          String?
  truckId            String?
  trailerId          String?
  driverId           String?
  employeeId         String?
  loadId             String?
  customerId         String?
  partyId            String?
  programId          String?
  businessType       String?
  memo               String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  transaction        FinancialTransaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  category           FinancialCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  company            Company?                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  truck              Truck?                  @relation(fields: [truckId], references: [id], onDelete: Restrict)
  trailer            Trailer?                @relation(fields: [trailerId], references: [id], onDelete: Restrict)
  driver             Driver?                 @relation(fields: [driverId], references: [id], onDelete: Restrict)
  employee           Employee?               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  load               Load?                   @relation(fields: [loadId], references: [id], onDelete: Restrict)
  customer           Customer?               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  party              FinancialParty?         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  program            FinancialProgram?       @relation(fields: [programId], references: [id], onDelete: Restrict)
  pilotProductLineId String?                 @unique
  pilotAdjustmentId  String?                 @unique
  pilotProductLine   PilotFuelProductLine?   @relation(fields: [pilotProductLineId], references: [id], onDelete: Restrict)
  pilotAdjustment    PilotInvoiceAdjustment? @relation(fields: [pilotAdjustmentId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([categoryId])
  @@index([companyId])
  @@index([truckId])
  @@index([trailerId])
  @@index([driverId])
  @@index([employeeId])
  @@index([loadId])
  @@index([customerId])
  @@index([partyId])
  @@index([programId])
}

model AdminFeeAgreement {
  id               String                 @id @default(cuid())
  operatingGroupId String
  scope            AdminFeeAgreementScope
  ownerPartyId     String?
  truckId          String?
  amountMinor      BigInt
  currency         String                 @default("USD")
  frequency        AdminFeeFrequency      @default(WEEKLY)
  effectiveFrom    DateTime               @db.Date
  effectiveTo      DateTime?              @db.Date
  isActive         Boolean                @default(true)
  createdByUserId  String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  operatingGroup   OperatingGroup         @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  ownerParty       FinancialParty?        @relation(fields: [ownerPartyId], references: [id], onDelete: Restrict)
  truck            Truck?                 @relation(fields: [truckId], references: [id], onDelete: Restrict)
  createdBy        User                   @relation("AdminFeeAgreementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([operatingGroupId, scope, isActive])
  @@index([ownerPartyId, effectiveFrom, effectiveTo])
  @@index([truckId, effectiveFrom, effectiveTo])
}

model FinancialExpectation {
  id                   String                      @id @default(cuid())
  operatingGroupId     String
  companyId            String?
  sourceId             String?
  customerId           String?
  partyId              String?
  loadId               String?
  truckId              String?
  expectedAmountMinor  BigInt
  matchedAmountMinor   BigInt                      @default(0)
  currency             String                      @default("USD")
  direction            FinancialDirection
  description          String
  expectedDateStart    DateTime
  expectedDateEnd      DateTime
  reference            String?
  status               FinancialExpectationStatus  @default(OPEN)
  createdByUserId      String
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  operatingGroup       OperatingGroup              @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  company              Company?                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  source               FinancialSource?            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  customer             Customer?                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  party                FinancialParty?             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  load                 Load?                       @relation(fields: [loadId], references: [id], onDelete: Restrict)
  truck                Truck?                      @relation(fields: [truckId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("FinancialExpectationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  matches              FinancialExpectationMatch[]
  pilotProviderInvoice PilotProviderInvoice?

  @@index([operatingGroupId, status, expectedDateStart])
  @@index([companyId, expectedDateStart])
  @@index([customerId])
  @@index([partyId])
  @@index([loadId])
}

model FinancialExpectationMatch {
  id                 String               @id @default(cuid())
  expectationId      String
  transactionId      String
  matchedAmountMinor BigInt
  matchedAt          DateTime             @default(now())
  expectation        FinancialExpectation @relation(fields: [expectationId], references: [id], onDelete: Restrict)
  transaction        FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([expectationId, transactionId])
  @@index([transactionId])
}

model FinancialAuditEvent {
  id                     String                @id @default(cuid())
  operatingGroupId       String
  companyId              String?
  transactionId          String?
  action                 String
  actorUserId            String
  pilotProviderInvoiceId String?
  bankTransactionId      String?
  before                 Json?
  after                  Json?
  metadata               Json?
  occurredAt             DateTime              @default(now())
  operatingGroup         OperatingGroup        @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  company                Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transaction            FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  actor                  User                  @relation("FinancialAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  pilotProviderInvoice   PilotProviderInvoice? @relation(fields: [pilotProviderInvoiceId], references: [id], onDelete: Restrict)
  bankTransaction        BankTransaction?      @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)

  @@index([operatingGroupId, occurredAt, id])
  @@index([transactionId, occurredAt, id])
  @@index([actorUserId, occurredAt, id])
  @@index([pilotProviderInvoiceId, occurredAt, id])
  @@index([bankTransactionId, occurredAt, id])
}

model PilotProviderInvoice {
  id                  String                   @id @default(cuid())
  operatingGroupId    String
  sourceId            String
  provider            String                   @default("PILOT")
  providerAccountHash String
  invoiceNumber       String
  billingDate         DateTime                 @db.Date
  dueDate             DateTime?                @db.Date
  periodStart         DateTime                 @db.Date
  periodEnd           DateTime                 @db.Date
  currency            String                   @default("USD")
  invoiceTotalMinor   BigInt
  parsedTotalMinor    BigInt
  differenceMinor     BigInt
  status              PilotInvoiceStatus       @default(UPLOADED)
  parseVersion        String
  expectationId       String?                  @unique
  uploadedByUserId    String
  postedByUserId      String?
  postedAt            DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  operatingGroup      OperatingGroup           @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  source              FinancialSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  expectation         FinancialExpectation?    @relation(fields: [expectationId], references: [id], onDelete: Restrict)
  uploadedBy          User                     @relation("PilotInvoiceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  postedBy            User?                    @relation("PilotInvoicePoster", fields: [postedByUserId], references: [id], onDelete: Restrict)
  documents           PilotInvoiceDocument[]
  events              PilotFuelingEvent[]
  productLines        PilotFuelProductLine[]
  adjustments         PilotInvoiceAdjustment[]
  issues              PilotImportIssue[]
  auditEvents         FinancialAuditEvent[]

  @@unique([operatingGroupId, provider, providerAccountHash, invoiceNumber])
  @@index([operatingGroupId, status, billingDate])
  @@index([sourceId, billingDate])
}

model PilotInvoiceDocument {
  id          String               @id @default(cuid())
  invoiceId   String
  statementId String
  role        PilotDocumentRole
  createdAt   DateTime             @default(now())
  invoice     PilotProviderInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  statement   FinancialStatement   @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, statementId])
  @@unique([statementId, role])
  @@index([invoiceId, role])
}

model PilotFuelingEvent {
  id                   String                 @id @default(cuid())
  invoiceId            String
  eventKeyHash         String
  ticketHash           String
  authorizationHash    String
  cardLastFour         String?
  sourceUnitNumber     String
  locationNumber       String?
  city                 String?
  state                String?
  purchaseOrderContext String?
  sourceDriverName     String?
  transactionDate      DateTime               @db.Date
  odometer             Decimal?               @db.Decimal(18, 2)
  truckId              String?
  truckMatchStatus     PilotTruckMatchStatus
  transactionId        String?                @unique
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  invoice              PilotProviderInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  truck                Truck?                 @relation(fields: [truckId], references: [id], onDelete: Restrict)
  transaction          FinancialTransaction?  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  productLines         PilotFuelProductLine[]
  issues               PilotImportIssue[]

  @@unique([invoiceId, eventKeyHash])
  @@index([invoiceId, transactionDate])
  @@index([truckId, transactionDate])
  @@index([invoiceId, truckMatchStatus])
}

model PilotFuelProductLine {
  id                 String                @id @default(cuid())
  invoiceId          String
  eventId            String
  importRecordId     String                @unique
  lineFingerprint    String
  sourceLineIdentity String
  sourceProductCode  String
  productType        PilotProductType
  quantity           Decimal               @db.Decimal(18, 2)
  unitPrice          Decimal               @db.Decimal(18, 7)
  amountMinor        BigInt
  retailAmountMinor  BigInt?
  savingsMinor       BigInt?
  taxMinor           BigInt?
  discountMinor      BigInt?
  currency           String                @default("USD")
  categoryId         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  invoice            PilotProviderInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  event              PilotFuelingEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  importRecord       FinancialImportRecord @relation(fields: [importRecordId], references: [id], onDelete: Restrict)
  category           FinancialCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  allocation         FinancialAllocation?
  issues             PilotImportIssue[]

  @@unique([invoiceId, sourceLineIdentity])
  @@index([invoiceId, lineFingerprint])
  @@index([invoiceId, productType])
  @@index([eventId, productType])
  @@index([categoryId])
}

model PilotInvoiceAdjustment {
  id                 String                @id @default(cuid())
  invoiceId          String
  importRecordId     String                @unique
  fingerprint        String
  sourceLineIdentity String
  type               PilotAdjustmentType   @default(OTHER)
  description        String
  transactionDate    DateTime?             @db.Date
  signedAmountMinor  BigInt
  categoryId         String?
  transactionId      String?               @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  invoice            PilotProviderInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  importRecord       FinancialImportRecord @relation(fields: [importRecordId], references: [id], onDelete: Restrict)
  category           FinancialCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transaction        FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  allocation         FinancialAllocation?
  issues             PilotImportIssue[]

  @@unique([invoiceId, sourceLineIdentity])
  @@index([invoiceId, fingerprint])
  @@index([invoiceId, type])
}

model PilotImportIssue {
  id                 String                  @id @default(cuid())
  invoiceId          String
  eventId            String?
  productLineId      String?
  adjustmentId       String?
  code               PilotImportIssueCode
  status             PilotImportIssueStatus  @default(OPEN)
  message            String
  resolutionMetadata Json?
  resolvedByUserId   String?
  resolvedAt         DateTime?
  createdAt          DateTime                @default(now())
  invoice            PilotProviderInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  event              PilotFuelingEvent?      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  productLine        PilotFuelProductLine?   @relation(fields: [productLineId], references: [id], onDelete: Restrict)
  adjustment         PilotInvoiceAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  resolvedBy         User?                   @relation("PilotIssueResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status, code])
  @@index([eventId, status])
  @@index([productLineId, status])
  @@index([adjustmentId, status])
}

model PilotProductMapping {
  id                  String            @id @default(cuid())
  operatingGroupId    String
  provider            String            @default("PILOT")
  providerAccountHash String
  productCode         String
  productType         PilotProductType
  categoryId          String
  version             Int               @default(1)
  isActive            Boolean           @default(true)
  approvedByUserId    String
  approvedAt          DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  operatingGroup      OperatingGroup    @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  category            FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  approvedBy          User              @relation("PilotProductMappingApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@unique([operatingGroupId, provider, providerAccountHash, productCode])
  @@index([categoryId, isActive])
  @@index([approvedByUserId, approvedAt])
}

model DriverOrientation {
  id          String   @id @default(cuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id])
  completedBy String
  completedAt DateTime @default(now())
  checklist   Json
  signature   String
  notes       String?
  createdAt   DateTime @default(now())
}

// ============ TASK MANAGER ============

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskActivityAction {
  PROJECT_CREATED
  TASK_CREATED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  STATUS_CHANGED
  BOARD_CHANGED
  PRIORITY_CHANGED
  EFFORT_CHANGED
  EXPECTED_DURATION_CHANGED
  BLOCKING_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  ORDER_CHANGED
  CHECKLIST_ITEM_CREATED
  CHECKLIST_ITEM_UPDATED
  CHECKLIST_ITEM_COMPLETED
  CHECKLIST_ITEM_REOPENED
  CHECKLIST_ITEM_REORDERED
  CHECKLIST_ITEM_DELETED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  MENTION_ADDED
  MENTION_RESOLVED
  TASK_DELETED
  TASK_ARCHIVED
  TASK_UNARCHIVED
}

enum TaskActivityActorType {
  UNATTRIBUTED
  USER
  EMPLOYEE
  SYSTEM
  INTEGRATION
  AI
}

enum TaskActivityEntityType {
  PROJECT
  TASK_CARD
}

enum TaskMentionSourceType {
  DESCRIPTION
  COMMENT
}

enum TaskBlockedReason {
  WAITING_ON_CUSTOMER
  WAITING_ON_DRIVER
  WAITING_ON_VENDOR
  WAITING_ON_MANAGER
  WAITING_ON_GOVERNMENT_DMV
  WAITING_ON_AMAZON
  WAITING_ON_INSURANCE
  TECHNICAL_ISSUE
  OTHER
}

model TaskProject {
  id          String         @id @default(cuid())
  name        String
  description String?
  color       String?        @default("#3b82f6")
  icon        String?        @default("📋")
  companyId   String?
  company     Company?       @relation(fields: [companyId], references: [id])
  isArchived  Boolean        @default(false)
  boards      TaskBoard[]
  cards       TaskCard[]
  activities  TaskActivity[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyId])
}

model TaskBoard {
  id        String      @id @default(cuid())
  projectId String
  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int         @default(0)
  color     String?     @default("#e5e7eb")
  status    TaskStatus?
  cards     TaskCard[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model TaskCard {
  id                      String                  @id @default(cuid())
  projectId               String
  project                 TaskProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boardId                 String
  board                   TaskBoard               @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title                   String
  description             String?                 @db.Text
  order                   Int                     @default(0)
  priority                TaskPriority            @default(MEDIUM)
  status                  TaskStatus              @default(TODO)
  assignedTo              String?
  assigneeUserId          String?
  assigneeUser            User?                   @relation("TaskCardAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdByUserId         String?
  createdByUser           User?                   @relation("TaskCardCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  isArchived              Boolean                 @default(false)
  archivedAt              DateTime?
  archivedByUserId        String?
  archivedByUser          User?                   @relation("TaskCardArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  dueDate                 DateTime?
  effort                  Int                     @default(3)
  expectedDurationMinutes Int?
  blockedReason           TaskBlockedReason?
  blockedSince            DateTime?
  blockedNote             String?                 @db.Text
  blockedClearedAt        DateTime?
  labels                  TaskLabel[]
  comments                TaskComment[]
  checklistItems          TaskChecklistItem[]
  attachments             TaskAttachment[]
  mentions                TaskMention[]
  activities              TaskActivity[]
  telegramDeliveries      TelegramDelivery[]
  telegramPendingActions  TelegramPendingAction[]
  telegramUpdateRequests  TelegramUpdateRequest[]
  startDate               DateTime?
  completedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([assigneeUserId])
  @@index([createdByUserId])
  @@index([archivedByUserId])
  @@index([projectId, isArchived, status, completedAt])
  @@index([assigneeUserId, dueDate, status])
}

model TaskLabel {
  id        String   @id @default(cuid())
  cardId    String
  card      TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#f3f4f6")
  createdAt DateTime @default(now())
}

model TaskComment {
  id                      String                  @id @default(cuid())
  cardId                  String
  card                    TaskCard                @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author                  String
  authorUserId            String?
  authorUser              User?                   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  content                 String                  @db.Text
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  mentions                TaskMention[]
  telegramUpdateResponses TelegramUpdateRequest[]

  @@index([authorUserId])
}

model TaskChecklistItem {
  id              String   @id @default(cuid())
  cardId          String
  card            TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  content         String
  isCompleted     Boolean  @default(false)
  order           Int      @default(0)
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cardId, order, id])
  @@index([createdByUserId])
}

model TaskActivity {
  id          String                 @id @default(cuid())
  projectId   String
  cardId      String?
  entityType  TaskActivityEntityType
  entityId    String
  entityTitle String?
  action      TaskActivityAction
  actorType   TaskActivityActorType  @default(UNATTRIBUTED)
  actorId     String?
  actorUserId String?
  sourceType  String?
  sourceId    String?
  metadata    Json?
  occurredAt  DateTime               @default(now())
  createdAt   DateTime               @default(now())

  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  card      TaskCard?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  actorUser User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, occurredAt, id])
  @@index([cardId, occurredAt, id])
  @@index([entityType, entityId, occurredAt, id])
  @@index([sourceType, sourceId])
  @@index([occurredAt, id])
  @@index([actorUserId, occurredAt, id])
}

model TaskAttachment {
  id               String   @id @default(cuid())
  cardId           String
  card             TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name             String
  url              String
  size             Int?
  mimeType         String?
  uploadedBy       String
  uploaderUserId   String?
  uploaderUser     User?    @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)
  originalFilename String?
  displayFilename  String?
  storageKey       String?  @unique
  byteSize         Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([cardId, createdAt, id])
  @@index([uploaderUserId])
}

model TaskMention {
  id                   String                @id @default(cuid())
  cardId               String
  card                 TaskCard              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  commentId            String?
  comment              TaskComment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId      String?
  mentionedUser        User?                 @relation("MentionedTaskUser", fields: [mentionedUserId], references: [id], onDelete: SetNull)
  mentionedDisplayName String
  sourceType           TaskMentionSourceType
  createdByUserId      String?
  createdByUser        User?                 @relation("TaskMentionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  createdAt            DateTime              @default(now())

  @@index([cardId, sourceType, createdAt])
  @@index([commentId])
  @@index([mentionedUserId, resolvedAt])
}
