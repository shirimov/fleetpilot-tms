  updatedAt               DateTime                   @updatedAt
  companies               OperatingGroupCompany[]
  memberships             OperatingGroupMembership[]
  sources                 FinancialSource[]
  statements              FinancialStatement[]
  categories              FinancialCategory[]
  programs                FinancialProgram[]
  adminFeeAgreements      AdminFeeAgreement[]
  parties                 FinancialParty[]
  transactions            FinancialTransaction[]
  expectations            FinancialExpectation[]
  auditEvents             FinancialAuditEvent[]
  pilotInvoices           PilotProviderInvoice[]
  pilotProductMappings    PilotProductMapping[]
  bankCategorizationRules BankCategorizationRule[]
}

model OperatingGroupCompany {
  operatingGroupId String
  companyId        String         @unique
  joinedAt         DateTime       @default(now())
  operatingGroup   OperatingGroup @relation(fields: [operatingGroupId], references: [id], onDelete: Cascade)
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([operatingGroupId, companyId])
  @@index([operatingGroupId])
}

model OperatingGroupMembership {
  operatingGroupId String
  userId           String
  role             CompanyMembershipRole
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  operatingGroup   OperatingGroup        @relation(fields: [operatingGroupId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([operatingGroupId, userId])
  @@index([userId, role])
}

model FinancialSource {
  id                   String                 @id @default(cuid())
  operatingGroupId     String
  companyId            String?
  name                 String
  type                 FinancialSourceType
  institution          String?
  provider             String?
  currency             String                 @default("USD")
  lastFour             String?
  isActive             Boolean                @default(true)
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  operatingGroup       OperatingGroup         @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  company              Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  statements           FinancialStatement[]
  transactions         FinancialTransaction[] @relation("FinancialTransactionSource")
  destinationTransfers FinancialTransaction[] @relation("FinancialTransactionDestination")
  expectations         FinancialExpectation[]
  pilotInvoices        PilotProviderInvoice[]

  @@unique([operatingGroupId, name])
  @@index([operatingGroupId, type, isActive])
  @@index([companyId])
}

model FinancialStatement {
  id                 String                  @id @default(cuid())
  operatingGroupId   String
  sourceId           String
  type               FinancialStatementType
  periodStart        DateTime
  periodEnd          DateTime
  statementDate      DateTime?
  originalFilename   String
  displayFilename    String
  mimeType           String
  byteSize           Int
  storageKey         String                  @unique
  checksumSha256     String
  importStatus       FinancialImportStatus   @default(UPLOADED)
  currency           String                  @default("USD")
  sourceTotalMinor   BigInt?
  importedRowCount   Int                     @default(0)
  matchedRowCount    Int                     @default(0)
  unresolvedRowCount Int                     @default(0)
  importedByUserId   String
  importedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  operatingGroup     OperatingGroup          @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  source             FinancialSource         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  importedBy         User                    @relation("FinancialStatementImporter", fields: [importedByUserId], references: [id], onDelete: Restrict)
  records            FinancialImportRecord[]
  pilotDocuments     PilotInvoiceDocument[]

  @@unique([operatingGroupId, checksumSha256])
  @@index([operatingGroupId, createdAt])
  @@index([sourceId, periodStart, periodEnd])
  @@index([importStatus, createdAt])
}

model FinancialImportRecord {
  id                   String                         @id @default(cuid())
  statementId          String
  sourceRowIndex       Int
  rawDescription       String?
  rawDate              String?
  rawAmount            String?
  rawReference         String?
  rawMetadata          Json?
  candidateDate        DateTime?
  candidateAmountMinor BigInt?
  candidateDirection   FinancialDirection?
  candidateDescription String?
  fingerprintSha256    String
  status               FinancialImportRecordStatus    @default(UNREVIEWED)
  createdAt            DateTime                       @default(now())
  statement            FinancialStatement             @relation(fields: [statementId], references: [id], onDelete: Restrict)
  evidence             FinancialTransactionEvidence[]
  pilotProductLine     PilotFuelProductLine?
  pilotAdjustment      PilotInvoiceAdjustment?

  @@unique([statementId, sourceRowIndex])
  @@index([statementId, status])
  @@index([fingerprintSha256])
}

model FinancialCategory {
  id                             String                          @id @default(cuid())
  operatingGroupId               String
  name                           String
  type                           FinancialCategoryType
  isActive                       Boolean                         @default(true)
  isSystemDefault                Boolean                         @default(false)
  parentCategoryId               String?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  operatingGroup                 OperatingGroup                  @relation(fields: [operatingGroupId], references: [id], onDelete: Cascade)
  parentCategory                 FinancialCategory?              @relation("FinancialCategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories                FinancialCategory[]             @relation("FinancialCategoryHierarchy")
  transactions                   FinancialTransaction[]
  allocations                    FinancialAllocation[]
  pilotProductMappings           PilotProductMapping[]
  pilotProductLines              PilotFuelProductLine[]
  pilotAdjustments               PilotInvoiceAdjustment[]
  bankTransactionClassifications BankTransactionClassification[]
  bankTransactionAllocations     BankTransactionAllocation[]
  bankCategorizationRules        BankCategorizationRule[]

  @@unique([operatingGroupId, name])
  @@index([operatingGroupId, type, isActive])
  @@index([parentCategoryId, isActive, name])
}

model FinancialProgram {
  id               String                @id @default(cuid())
