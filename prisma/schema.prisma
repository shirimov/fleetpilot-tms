  address                 String?
  emergencyContact        String?
  privateNotes            String?               @db.Text
  photoStorageKey         String?
  photoMimeType           String?
  country                 String                @default("Turkmenistan")
  city                    String?
  region                  String? // Mary, Ashgabat, Balkan, Dashoguz, Lebap
