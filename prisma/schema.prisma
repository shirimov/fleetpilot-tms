  skill      EmployeeSkillDefinition @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([employeeId, skillId])
  @@index([skillId, employeeId])
}

model EmployeePayment {
  id         String        @id @default(cuid())
