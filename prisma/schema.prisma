generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TruckStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum CabType {
  DAYCAB
  SLEEPER
  OWNER_OP
}

enum DriverPayType {
  PERCENTAGE
  PER_MILE
  FLAT
}

enum LoadStatus {
  DRAFT
  PLANNED
  ASSIGNED
  DISPATCHED
  PICKED_UP
  PENDING
  IN_TRANSIT
  DELIVERED
  POD_UPLOADED
  INVOICED
  PAID
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum TrailerEquipmentType {
  DRY_VAN
  REEFER
  FLATBED
  STEP_DECK
  POWER_ONLY
  OTHER
}

enum TrailerStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  MAINTENANCE
  OUT_OF_SERVICE
  INACTIVE
}

enum LoadStopType {
  PICKUP
  DELIVERY
}

enum DispatchDocumentType {
  RATE_CONFIRMATION
  BOL
  POD
  RECEIPT
  TRAILER_REGISTRATION
  TRAILER_INSURANCE
  TRAILER_INSPECTION
  OTHER
}

enum LoadActivityAction {
  LOAD_CREATED
  LOAD_UPDATED
  STATUS_CHANGED
  ASSIGNMENT_CHANGED
  STOP_CREATED
  STOP_UPDATED
  STOP_DELETED
  DOCUMENT_ADDED
  DOCUMENT_REMOVED
}

model Company {
  id                     String                    @id @default(cuid())
  name                   String
  dotNumber              String?
  mcNumber               String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  trucks                 Truck[]
  loads                  Load[]
  bankAccounts           BankAccount[]
  taskProjects           TaskProject[]
  memberships            CompanyMembership[]
  activeUsers            User[]                    @relation("ActiveCompany")
  companyDrivers         Driver[]                  @relation("DriverCompany")
  employees              Employee[]
  employeeSkills         EmployeeSkillDefinition[]
  customers              Customer[]
  trailers               Trailer[]
  loadActivities         LoadActivity[]
  telegramUserLinks      TelegramUserLink[]
  telegramLinkTokens     TelegramLinkToken[]
  telegramInboundUpdates TelegramInboundUpdate[]
  telegramDeliveries     TelegramDelivery[]
  telegramPendingActions TelegramPendingAction[]
  telegramUpdateRequests TelegramUpdateRequest[]
  operatingGroupLink     OperatingGroupCompany?
  financialSources       FinancialSource[]
  financialTransactions  FinancialTransaction[]
  financialAllocations   FinancialAllocation[]
  financialExpectations  FinancialExpectation[]
  financialParties       FinancialParty[]
  financialAuditEvents   FinancialAuditEvent[]
}

enum CompanyMembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  displayName     String
  image           String?
  isActive        Boolean  @default(true)
  activeCompanyId String?
  activeCompany   Company? @relation("ActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authAccounts                  AuthAccount[]
  emailSignInTokens             EmailSignInToken[]
  memberships                   CompanyMembership[]
  taskComments                  TaskComment[]
  taskActivities                TaskActivity[]
  taskChecklistItems            TaskChecklistItem[]
  taskAttachments               TaskAttachment[]
  assignedTaskCards             TaskCard[]                     @relation("TaskCardAssignee")
  taskMentions                  TaskMention[]                  @relation("MentionedTaskUser")
  createdTaskMentions           TaskMention[]                  @relation("TaskMentionCreator")
  loadActivities                LoadActivity[]
  uploadedLoadDocuments         LoadDocument[]
  uploadedTrailerDocuments      TrailerDocument[]
  telegramUserLinks             TelegramUserLink[]
  telegramLinkTokens            TelegramLinkToken[]
  telegramDeliveries            TelegramDelivery[]
  telegramPendingActions        TelegramPendingAction[]        @relation("TelegramPendingActionUser")
  requestedTelegramUpdates      TelegramUpdateRequest[]        @relation("TelegramUpdateRequester")
  assignedTelegramUpdates       TelegramUpdateRequest[]        @relation("TelegramUpdateAssignee")
  employeeProfile               Employee?
  operatingGroupMemberships     OperatingGroupMembership[]
  importedFinancialStatements   FinancialStatement[]           @relation("FinancialStatementImporter")
  createdFinancialTransactions  FinancialTransaction[]         @relation("FinancialTransactionCreator")
  reviewedFinancialTransactions FinancialTransaction[]         @relation("FinancialTransactionReviewer")
  waivedFinancialTransactions   FinancialTransaction[]         @relation("FinancialTransactionWaiver")
  matchedFinancialEvidence      FinancialTransactionEvidence[] @relation("FinancialEvidenceMatcher")
  createdFinancialExpectations  FinancialExpectation[]         @relation("FinancialExpectationCreator")
  financialAuditEvents          FinancialAuditEvent[]          @relation("FinancialAuditActor")
  createdAdminFeeAgreements     AdminFeeAgreement[]            @relation("AdminFeeAgreementCreator")

  @@index([activeCompanyId])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailSignInToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([expiresAt])
}

model EmailSignInRequest {
  id        String   @id @default(cuid())
  emailHash String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

model CompanyMembership {
  id        String                @id @default(cuid())
  userId    String
  companyId String
  role      CompanyMembershipRole @default(MEMBER)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role])
}

enum TelegramDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRYING
  PERMANENT_FAILURE
  CANCELLED
}

enum TelegramDeliveryType {
  ASSIGNMENT
  UPDATE_REQUEST
  COMMAND_RESPONSE
  CALLBACK_RESPONSE
}

enum TelegramPendingActionType {
  ADD_UPDATE
  START_TASK
  COMPLETE_TASK
  OPEN_TASK
}

enum TelegramUpdateRequestStatus {
  PENDING
  RESPONDED
  EXPIRED
  CANCELLED
}

model TelegramUserLink {
  id               String   @id @default(cuid())
  companyId        String
  userId           String
  telegramUserId   BigInt   @unique
  telegramChatId   BigInt   @unique
  telegramUsername String?
  verifiedAt       DateTime
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId, enabled])
  @@index([userId, enabled])
}

model TelegramLinkToken {
  id         String    @id @default(cuid())
  companyId  String
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, expiresAt])
  @@index([userId, consumedAt, expiresAt])
}

model TelegramInboundUpdate {
  id               String    @id @default(cuid())
  companyId        String?
  telegramUserId   BigInt?
  telegramChatId   BigInt?
  telegramUpdateId BigInt    @unique
  kind             String
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([telegramUserId, createdAt])
}

model TelegramDelivery {
  id                String                 @id @default(cuid())
  companyId         String
  userId            String
  taskCardId        String?
  type              TelegramDeliveryType
  telegramChatId    BigInt
  telegramMessageId BigInt?
  payload           Json
  dedupeKey         String?
  status            TelegramDeliveryStatus @default(PENDING)
  attempts          Int                    @default(0)
  nextAttemptAt     DateTime               @default(now())
  lastError         String?
  createdAt         DateTime               @default(now())
  deliveredAt       DateTime?
  updatedAt         DateTime               @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskCard TaskCard? @relation(fields: [taskCardId], references: [id], onDelete: SetNull)

  @@unique([dedupeKey])
  @@index([companyId, status, nextAttemptAt, createdAt])
  @@index([userId, status, nextAttemptAt])
  @@index([taskCardId, type, createdAt])
}

model TelegramUpdateRequest {
  id                String                      @id @default(cuid())
  companyId         String
  taskCardId        String
  requestedByUserId String
  assigneeUserId    String
  status            TelegramUpdateRequestStatus @default(PENDING)
  telegramMessageId BigInt?
  expiresAt         DateTime
  respondedAt       DateTime?
  responseCommentId String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskCard        TaskCard                @relation(fields: [taskCardId], references: [id], onDelete: Cascade)
  requestedByUser User                    @relation("TelegramUpdateRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  assigneeUser    User                    @relation("TelegramUpdateAssignee", fields: [assigneeUserId], references: [id], onDelete: Cascade)
  responseComment TaskComment?            @relation(fields: [responseCommentId], references: [id], onDelete: SetNull)
  pendingActions  TelegramPendingAction[]

  @@index([companyId, assigneeUserId, status, createdAt])
  @@index([taskCardId, status, createdAt])
  @@index([responseCommentId])
}

model TelegramPendingAction {
  id                      String                    @id @default(cuid())
  companyId               String
  userId                  String
  taskCardId              String?
  telegramChatId          BigInt
  type                    TelegramPendingActionType
  requestedByUserId       String?
  telegramMessageId       BigInt?
  telegramUpdateRequestId String?
  expiresAt               DateTime
  consumedAt              DateTime?
  invalidatedAt           DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User                   @relation("TelegramPendingActionUser", fields: [userId], references: [id], onDelete: Cascade)
  taskCard      TaskCard?              @relation(fields: [taskCardId], references: [id], onDelete: Cascade)
  updateRequest TelegramUpdateRequest? @relation(fields: [telegramUpdateRequestId], references: [id], onDelete: SetNull)

  @@index([companyId, userId, type, expiresAt])
  @@index([telegramChatId, type, expiresAt])
  @@index([taskCardId, type, expiresAt])
}

model Truck {
  id                    String                 @id @default(cuid())
  unitNumber            String                 @unique
  vin                   String?
  year                  Int?
  make                  String?
  model                 String?
  status                TruckStatus            @default(ACTIVE)
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id])
  cabType               CabType                @default(SLEEPER)
  isOwnerOp             Boolean                @default(false)
  ownerName             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  drivers               Driver[]
  loads                 Load[]
  settlements           Settlement[]
  truckInspections      TruckInspection[]
  financialAllocations  FinancialAllocation[]
  financialExpectations FinancialExpectation[]
  adminFeeAgreements    AdminFeeAgreement[]
}

model Customer {
  id                    String                 @id @default(cuid())
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  status                CustomerStatus         @default(ACTIVE)
  mcNumber              String?
  dotNumber             String?
  email                 String?
  phone                 String?
  notes                 String?                @db.Text
  contacts              CustomerContact[]
  loads                 Load[]
  financialAllocations  FinancialAllocation[]
  financialExpectations FinancialExpectation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  financialTransactions FinancialTransaction[]

  @@unique([companyId, name])
  @@index([companyId, status, name])
}

model CustomerContact {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  title      String?
  email      String?
  phone      String?
  notes      String?    @db.Text
  loadStops  LoadStop[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, name])
}

model Trailer {
  id                   String                @id @default(cuid())
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitNumber           String
  equipmentType        TrailerEquipmentType  @default(DRY_VAN)
  status               TrailerStatus         @default(AVAILABLE)
  vin                  String?
  plate                String?
  state                String?
  notes                String?               @db.Text
  loads                Load[]
  documents            TrailerDocument[]
  financialAllocations FinancialAllocation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([companyId, unitNumber])
  @@index([companyId, status, equipmentType])
}

model Driver {
  id                   String                @id @default(cuid())
  companyId            String?
  company              Company?              @relation("DriverCompany", fields: [companyId], references: [id])
  firstName            String
  lastName             String
  phone                String?
  email                String?
  licenseNum           String?
  payType              DriverPayType         @default(PERCENTAGE)
  payRate              Float
  truckId              String?
  truck                Truck?                @relation(fields: [truckId], references: [id])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  loads                Load[]
  settlements          Settlement[]
  driverOrientations   DriverOrientation[]
  financialAllocations FinancialAllocation[]

  @@index([companyId])
}

model Load {
  id                    String                 @id @default(cuid())
  loadNumber            String                 @unique
  referenceNum          String?
  status                LoadStatus             @default(DRAFT)
  origin                String
  destination           String
  pickupDate            DateTime?
  deliveryDate          DateTime?
  miles                 Float?
  rate                  Float
  fuelSurcharge         Float?                 @default(0)
  truckId               String?
  truck                 Truck?                 @relation(fields: [truckId], references: [id])
  driverId              String?
  driver                Driver?                @relation(fields: [driverId], references: [id])
  trailerId             String?
  trailer               Trailer?               @relation(fields: [trailerId], references: [id])
  customerId            String?
  customer              Customer?              @relation(fields: [customerId], references: [id])
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id])
  notes                 String?                @db.Text
  invoiceNumber         String?
  stops                 LoadStop[]
  documents             LoadDocument[]
  activities            LoadActivity[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  settlement            Settlement?
  financialAllocations  FinancialAllocation[]
  financialExpectations FinancialExpectation[]

  @@index([companyId, status, pickupDate])
  @@index([companyId, truckId, pickupDate, deliveryDate])
  @@index([companyId, driverId, pickupDate, deliveryDate])
  @@index([companyId, trailerId, pickupDate, deliveryDate])
  @@index([customerId])
}

model LoadStop {
  id               String           @id @default(cuid())
  loadId           String
  load             Load             @relation(fields: [loadId], references: [id], onDelete: Cascade)
  type             LoadStopType
  order            Int
  facilityName     String
  addressLine1     String?
  addressLine2     String?
  city             String
  state            String?
  postalCode       String?
  country          String           @default("US")
  contactId        String?
  contact          CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName      String?
  contactPhone     String?
  appointmentStart DateTime?
  appointmentEnd   DateTime?
  arrivedAt        DateTime?
  departedAt       DateTime?
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([loadId, order])
  @@index([loadId, type, order])
  @@index([contactId])
}

model LoadDocument {
  id               String               @id @default(cuid())
  loadId           String
  load             Load                 @relation(fields: [loadId], references: [id], onDelete: Cascade)
  type             DispatchDocumentType
  originalFilename String
  displayFilename  String
  mimeType         String
  byteSize         Int
  storageKey       String               @unique
  uploaderUserId   String?
  uploaderUser     User?                @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@index([loadId, type, createdAt])
  @@index([uploaderUserId])
}

model TrailerDocument {
  id               String               @id @default(cuid())
  trailerId        String
  trailer          Trailer              @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  type             DispatchDocumentType
  originalFilename String
  displayFilename  String
  mimeType         String
  byteSize         Int
  storageKey       String               @unique
  expiresAt        DateTime?
  uploaderUserId   String?
  uploaderUser     User?                @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@index([trailerId, type, createdAt])
  @@index([uploaderUserId])
}

model LoadActivity {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  loadId      String?
  load        Load?              @relation(fields: [loadId], references: [id], onDelete: SetNull)
  loadNumber  String
  action      LoadActivityAction
  actorUserId String?
  actorUser   User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata    Json?
  occurredAt  DateTime           @default(now())
  createdAt   DateTime           @default(now())

  @@index([companyId, occurredAt, id])
  @@index([loadId, occurredAt, id])
  @@index([actorUserId, occurredAt, id])
}

model Settlement {
  id              String    @id @default(cuid())
  weekEnding      DateTime
  truckId         String
  truck           Truck     @relation(fields: [truckId], references: [id])
  driverId        String?
  driver          Driver?   @relation(fields: [driverId], references: [id])
  loadId          String?   @unique
  load            Load?     @relation(fields: [loadId], references: [id])
  grossRevenue    Float
  driverPay       Float
  fuelDeduction   Float     @default(0)
  otherDeductions Float     @default(0)
  netPay          Float
  isPaid          Boolean   @default(false)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TruckInspection {
  id             String   @id @default(cuid())
  truckId        String
  truck          Truck    @relation(fields: [truckId], references: [id])
  inspectedBy    String
  inspectedAt    DateTime @default(now())
  phase1         Json
  phase2         Json
  phase3         Json
  currentMileage Int?
  notes          String?
  passed         Boolean  @default(true)
  photos         Json?
  createdAt      DateTime @default(now())
}

model BankAccount {
  id               String            @id @default(cuid())
  companyId        String?
  company          Company?          @relation(fields: [companyId], references: [id])
  plaidItemId      String            @unique
  plaidAccessToken String
  institutionId    String?
  institutionName  String?
  accounts         BankSubAccount[]
  transactions     BankTransaction[]
  lastSync         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BankSubAccount {
  id               String            @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount       @relation(fields: [bankAccountId], references: [id])
  plaidAccountId   String            @unique
  name             String
  officialName     String?
  type             String
  subtype          String?
  mask             String?
  currentBalance   Float?
  availableBalance Float?
  transactions     BankTransaction[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BankTransaction {
  id                 String          @id @default(cuid())
  bankAccountId      String
  bankAccount        BankAccount     @relation(fields: [bankAccountId], references: [id])
  subAccountId       String?
  subAccount         BankSubAccount? @relation(fields: [subAccountId], references: [id])
  plaidTransactionId String          @unique
  date               DateTime
  amount             Float
  name               String
  merchantName       String?
  category           String?
  subCategory        String?
  pending            Boolean         @default(false)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model EmailAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  label     String
  password  String
  imapHost  String   @default("imap.gmail.com")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emails    Email[]
}

model Email {
  id        String       @id @default(cuid())
  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id])
  messageId String
  from      String
  subject   String
  date      DateTime
  body      String       @db.Text
  isRead    Boolean      @default(false)
  isHandled Boolean      @default(false)
  priority  String       @default("normal")
  category  String?
  createdAt DateTime     @default(now())

  @@unique([accountId, messageId])
}

enum EmployeeRole {
  DISPATCHER
  LEAD_DISPATCH
  UPDATER
  ACCOUNTANT
  MANAGER
  ADMIN
  SAFETY
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  TEMPORARY
}

enum EmploymentStatus {
  ACTIVE
  LEAVE
  INACTIVE
  TERMINATED
}

enum EmployeePayType {
  SALARY
  HOURLY
}

enum EmployeePayFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

model Employee {
  id                      String                @id @default(cuid())
  companyId               String?
  company                 Company?              @relation(fields: [companyId], references: [id])
  userId                  String?               @unique
  user                    User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName               String
  lastName                String
  role                    EmployeeRole          @default(DISPATCHER)
  roleCustom              String?
  phone                   String?
  email                   String?
  preferredName           String?
  jobTitle                String?
  department              String?
  managerId               String?
  manager                 Employee?             @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports           Employee[]            @relation("EmployeeManager")
  workLocation            String?
  timezone                String                @default("UTC")
  employmentType          EmploymentType        @default(FULL_TIME)
  employmentStatus        EmploymentStatus      @default(ACTIVE)
  birthDate               DateTime?
  address                 String?
  emergencyContact        String?
  privateNotes            String?               @db.Text
  photoStorageKey         String?
  photoMimeType           String?
  country                 String                @default("Turkmenistan")
  city                    String?
  region                  String? // Mary, Ashgabat, Balkan, Dashoguz, Lebap
  salary                  Float?
  payType                 EmployeePayType       @default(SALARY)
  payFrequency            EmployeePayFrequency  @default(MONTHLY)
  compensationEffectiveAt DateTime?
  compensationNotes       String?               @db.Text
  currency                String                @default("USD")
  paymentMethod           String                @default("Bank Transfer")
  startDate               DateTime?
  isActive                Boolean               @default(true)
  notes                   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  payments                EmployeePayment[]
  scheduleDays            EmployeeScheduleDay[]
  skills                  EmployeeSkill[]
  financialAllocations    FinancialAllocation[]

  @@index([companyId])
  @@index([companyId, employmentStatus])
  @@index([companyId, managerId])
}

model EmployeeScheduleDay {
  id              String   @id @default(cuid())
  employeeId      String
  weekday         Int
  isWorking       Boolean  @default(false)
  startMinute     Int?
  endMinute       Int?
  breakMinutes    Int      @default(0)
  capacityMinutes Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekday])
  @@index([employeeId, isWorking])
}

model EmployeeSkillDefinition {
  id        String          @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees EmployeeSkill[]

  @@unique([companyId, name])
  @@index([companyId, isActive, name])
}

model EmployeeSkill {
  employeeId String
  skillId    String
  createdAt  DateTime                @default(now())
  employee   Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill      EmployeeSkillDefinition @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([employeeId, skillId])
  @@index([skillId, employeeId])
}

model EmployeePayment {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  amount     Float
  currency   String        @default("USD")
  period     String // e.g. "2026-04"
  method     String        @default("Bank Transfer")
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

enum TmFundTxType {
  DEPOSIT
  PAYMENT
  EXPENSE
  ADJUSTMENT
}

model TmFund {
  id           String     @id @default(cuid())
  name         String     @default("Turkmenistan Fund")
  balance      Float      @default(0)
  currency     String     @default("USD")
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  transactions TmFundTx[]
}

model TmFundTx {
  id          String       @id @default(cuid())
  fundId      String
  fund        TmFund       @relation(fields: [fundId], references: [id])
  type        TmFundTxType
  amount      Float
  description String
  region      String? // Mary, Ashgabat, Balkan, Dashoguz, Lebap
  employeeId  String?
  paymentRef  String?
  date        DateTime     @default(now())
  notes       String?
  createdAt   DateTime     @default(now())
}

model DispatchReserve {
  id          String   @id @default(cuid())
  amount      Float
  description String
  period      String
  createdAt   DateTime @default(now())
}

model EmployeeEscrow {
  id           String     @id @default(cuid())
  employeeId   String     @unique
  balance      Float      @default(0)
  target       Float      @default(0) // should equal salary/weight pay
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  transactions EscrowTx[]
}

model EscrowTx {
  id          String         @id @default(cuid())
  escrowId    String
  escrow      EmployeeEscrow @relation(fields: [escrowId], references: [id])
  amount      Float
  type        String // DEPOSIT, DEDUCTION
  description String
  date        DateTime       @default(now())
  createdAt   DateTime       @default(now())
}

enum FinancialSourceType {
  BANK_ACCOUNT
  CREDIT_CARD
  FUEL_CARD
  TOLL_ACCOUNT
  TMS_SETTLEMENT
  CUSTOMER_SETTLEMENT
  OWNER_SETTLEMENT
  CASH
  OTHER
}

enum FinancialStatementType {
  BANK_STATEMENT
  CREDIT_CARD_STATEMENT
  FUEL_STATEMENT
  TOLL_STATEMENT
  TMS_SETTLEMENT
  CUSTOMER_SETTLEMENT
  OWNER_SETTLEMENT
  REPAIR_INVOICE
  INSURANCE_STATEMENT
  OTHER
}

enum FinancialImportStatus {
  UPLOADED
  IMPORTING
  IMPORTED
  NEEDS_REVIEW
  FAILED
}

enum FinancialImportRecordStatus {
  UNREVIEWED
  MATCHED
  PARTIALLY_MATCHED
  DUPLICATE_SUSPECTED
  NEEDS_REVIEW
}

enum FinancialDirection {
  INFLOW
  OUTFLOW
  TRANSFER
}

enum FinancialTransactionStatus {
  DRAFT
  POSTED
  VOIDED
}

enum FinancialReconciliationStatus {
  UNREVIEWED
  MATCHED
  PARTIALLY_MATCHED
  UNMATCHED
  MISSING_EXPECTED
  DUPLICATE_SUSPECTED
  NEEDS_REVIEW
  RECONCILED
}

enum FinancialMatchMethod {
  EXACT
  PARTIAL
  SPLIT
  MANUAL
  SUGGESTED
}

enum FinancialEvidenceRole {
  PRIMARY
  CORROBORATING
}

enum FinancialCategoryType {
  INCOME
  DIRECT_EXPENSE
  EQUIPMENT_FINANCING
  OVERHEAD
  OTHER
}

enum FinancialPartyType {
  VENDOR
  OWNER_OPERATOR
  OTHER
}

enum FinancialRecoveryStatus {
  NOT_APPLICABLE
  EXPECTED
  PARTIALLY_RECOVERED
  OPEN
  PARTIAL
  RECOVERED
  WAIVED
}

enum FinancialExpectationStatus {
  OPEN
  PARTIALLY_MATCHED
  MATCHED
  MISSING
  CANCELLED
}

enum FinancialDataStatus {
  RAW
  NORMALIZED
  REVIEWED
  VERIFIED
}

enum FinancialProgramType {
  ADMIN
  SAFETY
  RECRUITING
  MAINTENANCE
  SHOP
  INSURANCE
  TRAILER_RENTAL
  OTHER
}

enum AdminFeeAgreementScope {
  OWNER
  TRUCK
}

enum AdminFeeFrequency {
  WEEKLY
}

model OperatingGroup {
  id                 String                     @id @default(cuid())
  name               String
  currency           String                     @default("USD")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  companies          OperatingGroupCompany[]
  memberships        OperatingGroupMembership[]
  sources            FinancialSource[]
  statements         FinancialStatement[]
  categories         FinancialCategory[]
  programs           FinancialProgram[]
  adminFeeAgreements AdminFeeAgreement[]
  parties            FinancialParty[]
  transactions       FinancialTransaction[]
  expectations       FinancialExpectation[]
  auditEvents        FinancialAuditEvent[]
}

model OperatingGroupCompany {
  operatingGroupId String
  companyId        String         @unique
  joinedAt         DateTime       @default(now())
  operatingGroup   OperatingGroup @relation(fields: [operatingGroupId], references: [id], onDelete: Cascade)
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([operatingGroupId, companyId])
  @@index([operatingGroupId])
}

model OperatingGroupMembership {
  operatingGroupId String
  userId           String
  role             CompanyMembershipRole
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  operatingGroup   OperatingGroup        @relation(fields: [operatingGroupId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([operatingGroupId, userId])
  @@index([userId, role])
}

model FinancialSource {
  id                   String                 @id @default(cuid())
  operatingGroupId     String
  companyId            String?
  name                 String
  type                 FinancialSourceType
  institution          String?
  provider             String?
  currency             String                 @default("USD")
  lastFour             String?
  isActive             Boolean                @default(true)
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  operatingGroup       OperatingGroup         @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  company              Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  statements           FinancialStatement[]
  transactions         FinancialTransaction[] @relation("FinancialTransactionSource")
  destinationTransfers FinancialTransaction[] @relation("FinancialTransactionDestination")
  expectations         FinancialExpectation[]

  @@unique([operatingGroupId, name])
  @@index([operatingGroupId, type, isActive])
  @@index([companyId])
}

model FinancialStatement {
  id                 String                  @id @default(cuid())
  operatingGroupId   String
  sourceId           String
  type               FinancialStatementType
  periodStart        DateTime
  periodEnd          DateTime
  statementDate      DateTime?
  originalFilename   String
  displayFilename    String
  mimeType           String
  byteSize           Int
  storageKey         String                  @unique
  checksumSha256     String
  importStatus       FinancialImportStatus   @default(UPLOADED)
  currency           String                  @default("USD")
  sourceTotalMinor   BigInt?
  importedRowCount   Int                     @default(0)
  matchedRowCount    Int                     @default(0)
  unresolvedRowCount Int                     @default(0)
  importedByUserId   String
  importedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  operatingGroup     OperatingGroup          @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  source             FinancialSource         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  importedBy         User                    @relation("FinancialStatementImporter", fields: [importedByUserId], references: [id], onDelete: Restrict)
  records            FinancialImportRecord[]

  @@unique([operatingGroupId, checksumSha256])
  @@index([operatingGroupId, createdAt])
  @@index([sourceId, periodStart, periodEnd])
  @@index([importStatus, createdAt])
}

model FinancialImportRecord {
  id                   String                         @id @default(cuid())
  statementId          String
  sourceRowIndex       Int
  rawDescription       String?
  rawDate              String?
  rawAmount            String?
  rawReference         String?
  rawMetadata          Json?
  candidateDate        DateTime?
  candidateAmountMinor BigInt?
  candidateDirection   FinancialDirection?
  candidateDescription String?
  fingerprintSha256    String
  status               FinancialImportRecordStatus    @default(UNREVIEWED)
  createdAt            DateTime                       @default(now())
  statement            FinancialStatement             @relation(fields: [statementId], references: [id], onDelete: Restrict)
  evidence             FinancialTransactionEvidence[]

  @@unique([statementId, sourceRowIndex])
  @@index([statementId, status])
  @@index([fingerprintSha256])
}

model FinancialCategory {
  id               String                 @id @default(cuid())
  operatingGroupId String
  name             String
  type             FinancialCategoryType
  isActive         Boolean                @default(true)
  isSystemDefault  Boolean                @default(false)
  parentCategoryId String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  operatingGroup   OperatingGroup         @relation(fields: [operatingGroupId], references: [id], onDelete: Cascade)
  parentCategory   FinancialCategory?     @relation("FinancialCategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories  FinancialCategory[]    @relation("FinancialCategoryHierarchy")
  transactions     FinancialTransaction[]
  allocations      FinancialAllocation[]

  @@unique([operatingGroupId, name])
  @@index([operatingGroupId, type, isActive])
  @@index([parentCategoryId, isActive, name])
}

model FinancialProgram {
  id               String                @id @default(cuid())
  operatingGroupId String
  code             String
  name             String
  type             FinancialProgramType  @default(OTHER)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  operatingGroup   OperatingGroup        @relation(fields: [operatingGroupId], references: [id], onDelete: Cascade)
  allocations      FinancialAllocation[]

  @@unique([operatingGroupId, code])
  @@unique([operatingGroupId, name])
  @@index([operatingGroupId, type, isActive])
}

model FinancialParty {
  id                 String                 @id @default(cuid())
  operatingGroupId   String
  companyId          String?
  type               FinancialPartyType
  name               String
  externalReference  String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  operatingGroup     OperatingGroup         @relation(fields: [operatingGroupId], references: [id], onDelete: Cascade)
  company            Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transactionVendor  FinancialTransaction[] @relation("FinancialTransactionVendor")
  transactionOwner   FinancialTransaction[] @relation("FinancialTransactionOwner")
  allocations        FinancialAllocation[]
  expectationParties FinancialExpectation[]
  adminFeeAgreements AdminFeeAgreement[]

  @@unique([operatingGroupId, type, name])
  @@index([companyId, type])
}

model FinancialTransaction {
  id                    String                         @id @default(cuid())
  operatingGroupId      String
  companyId             String?
  sourceId              String?
  destinationSourceId   String?
  transactionDate       DateTime
  amountMinor           BigInt
  currency              String                         @default("USD")
  direction             FinancialDirection
  description           String
  categoryId            String?
  vendorId              String?
  ownerId               String?
  customerId            String?
  status                FinancialTransactionStatus     @default(DRAFT)
  reconciliationStatus  FinancialReconciliationStatus  @default(UNREVIEWED)
  dataStatus            FinancialDataStatus            @default(NORMALIZED)
  memo                  String?
  reference             String?
  fingerprintSha256     String?
  recoverableFromOwner  Boolean                        @default(false)
  expectedRecoveryMinor BigInt                         @default(0)
  recoveredAmountMinor  BigInt                         @default(0)
  waivedAmountMinor     BigInt                         @default(0)
  recoveryStatus        FinancialRecoveryStatus        @default(NOT_APPLICABLE)
  recoveryNotes         String?
  lastRecoveryAt        DateTime?
  waivedAt              DateTime?
  waivedByUserId        String?
  createdByUserId       String
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  operatingGroup        OperatingGroup                 @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  company               Company?                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  source                FinancialSource?               @relation("FinancialTransactionSource", fields: [sourceId], references: [id], onDelete: Restrict)
  destinationSource     FinancialSource?               @relation("FinancialTransactionDestination", fields: [destinationSourceId], references: [id], onDelete: Restrict)
  category              FinancialCategory?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor                FinancialParty?                @relation("FinancialTransactionVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  owner                 FinancialParty?                @relation("FinancialTransactionOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  customer              Customer?                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy             User                           @relation("FinancialTransactionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy            User?                          @relation("FinancialTransactionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  waivedBy              User?                          @relation("FinancialTransactionWaiver", fields: [waivedByUserId], references: [id], onDelete: Restrict)
  evidence              FinancialTransactionEvidence[]
  allocations           FinancialAllocation[]
  expectationMatches    FinancialExpectationMatch[]
  auditEvents           FinancialAuditEvent[]

  @@index([operatingGroupId, transactionDate])
  @@index([companyId, transactionDate])
  @@index([destinationSourceId, transactionDate])
  @@index([reconciliationStatus, transactionDate])
  @@index([categoryId, transactionDate])
  @@index([fingerprintSha256])
}

model FinancialTransactionEvidence {
  id                    String                @id @default(cuid())
  transactionId         String
  importRecordId        String
  matchedAmountMinor    BigInt
  method                FinancialMatchMethod
  role                  FinancialEvidenceRole @default(PRIMARY)
  confidenceBasisPoints Int?
  matchedByUserId       String
  matchedAt             DateTime              @default(now())
  transaction           FinancialTransaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  importRecord          FinancialImportRecord @relation(fields: [importRecordId], references: [id], onDelete: Restrict)
  matchedBy             User                  @relation("FinancialEvidenceMatcher", fields: [matchedByUserId], references: [id], onDelete: Restrict)

  @@unique([transactionId, importRecordId])
  @@index([importRecordId, matchedAt])
  @@index([transactionId, matchedAt])
}

model FinancialAllocation {
  id            String               @id @default(cuid())
  transactionId String
  amountMinor   BigInt
  categoryId    String
  companyId     String?
  truckId       String?
  trailerId     String?
  driverId      String?
  employeeId    String?
  loadId        String?
  customerId    String?
  partyId       String?
  programId     String?
  businessType  String?
  memo          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  category      FinancialCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  company       Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  truck         Truck?               @relation(fields: [truckId], references: [id], onDelete: Restrict)
  trailer       Trailer?             @relation(fields: [trailerId], references: [id], onDelete: Restrict)
  driver        Driver?              @relation(fields: [driverId], references: [id], onDelete: Restrict)
  employee      Employee?            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  load          Load?                @relation(fields: [loadId], references: [id], onDelete: Restrict)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  party         FinancialParty?      @relation(fields: [partyId], references: [id], onDelete: Restrict)
  program       FinancialProgram?    @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([categoryId])
  @@index([companyId])
  @@index([truckId])
  @@index([trailerId])
  @@index([driverId])
  @@index([employeeId])
  @@index([loadId])
  @@index([customerId])
  @@index([partyId])
  @@index([programId])
}

model AdminFeeAgreement {
  id               String                 @id @default(cuid())
  operatingGroupId String
  scope            AdminFeeAgreementScope
  ownerPartyId     String?
  truckId          String?
  amountMinor      BigInt
  currency         String                 @default("USD")
  frequency        AdminFeeFrequency      @default(WEEKLY)
  effectiveFrom    DateTime               @db.Date
  effectiveTo      DateTime?              @db.Date
  isActive         Boolean                @default(true)
  createdByUserId  String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  operatingGroup   OperatingGroup         @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  ownerParty       FinancialParty?        @relation(fields: [ownerPartyId], references: [id], onDelete: Restrict)
  truck            Truck?                 @relation(fields: [truckId], references: [id], onDelete: Restrict)
  createdBy        User                   @relation("AdminFeeAgreementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([operatingGroupId, scope, isActive])
  @@index([ownerPartyId, effectiveFrom, effectiveTo])
  @@index([truckId, effectiveFrom, effectiveTo])
}

model FinancialExpectation {
  id                  String                      @id @default(cuid())
  operatingGroupId    String
  companyId           String?
  sourceId            String?
  customerId          String?
  partyId             String?
  loadId              String?
  truckId             String?
  expectedAmountMinor BigInt
  matchedAmountMinor  BigInt                      @default(0)
  currency            String                      @default("USD")
  direction           FinancialDirection
  description         String
  expectedDateStart   DateTime
  expectedDateEnd     DateTime
  reference           String?
  status              FinancialExpectationStatus  @default(OPEN)
  createdByUserId     String
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  operatingGroup      OperatingGroup              @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  company             Company?                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  source              FinancialSource?            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  customer            Customer?                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  party               FinancialParty?             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  load                Load?                       @relation(fields: [loadId], references: [id], onDelete: Restrict)
  truck               Truck?                      @relation(fields: [truckId], references: [id], onDelete: Restrict)
  createdBy           User                        @relation("FinancialExpectationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  matches             FinancialExpectationMatch[]

  @@index([operatingGroupId, status, expectedDateStart])
  @@index([companyId, expectedDateStart])
  @@index([customerId])
  @@index([partyId])
  @@index([loadId])
}

model FinancialExpectationMatch {
  id                 String               @id @default(cuid())
  expectationId      String
  transactionId      String
  matchedAmountMinor BigInt
  matchedAt          DateTime             @default(now())
  expectation        FinancialExpectation @relation(fields: [expectationId], references: [id], onDelete: Restrict)
  transaction        FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([expectationId, transactionId])
  @@index([transactionId])
}

model FinancialAuditEvent {
  id               String                @id @default(cuid())
  operatingGroupId String
  companyId        String?
  transactionId    String?
  action           String
  actorUserId      String
  before           Json?
  after            Json?
  metadata         Json?
  occurredAt       DateTime              @default(now())
  operatingGroup   OperatingGroup        @relation(fields: [operatingGroupId], references: [id], onDelete: Restrict)
  company          Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transaction      FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  actor            User                  @relation("FinancialAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([operatingGroupId, occurredAt, id])
  @@index([transactionId, occurredAt, id])
  @@index([actorUserId, occurredAt, id])
}

model DriverOrientation {
  id          String   @id @default(cuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id])
  completedBy String
  completedAt DateTime @default(now())
  checklist   Json
  signature   String
  notes       String?
  createdAt   DateTime @default(now())
}

// ============ TASK MANAGER ============

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskActivityAction {
  PROJECT_CREATED
  TASK_CREATED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  STATUS_CHANGED
  BOARD_CHANGED
  PRIORITY_CHANGED
  EFFORT_CHANGED
  EXPECTED_DURATION_CHANGED
  BLOCKING_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  ORDER_CHANGED
  CHECKLIST_ITEM_CREATED
  CHECKLIST_ITEM_UPDATED
  CHECKLIST_ITEM_COMPLETED
  CHECKLIST_ITEM_REOPENED
  CHECKLIST_ITEM_REORDERED
  CHECKLIST_ITEM_DELETED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  MENTION_ADDED
  MENTION_RESOLVED
  TASK_DELETED
}

enum TaskActivityActorType {
  UNATTRIBUTED
  USER
  EMPLOYEE
  SYSTEM
  INTEGRATION
  AI
}

enum TaskActivityEntityType {
  PROJECT
  TASK_CARD
}

enum TaskMentionSourceType {
  DESCRIPTION
  COMMENT
}

enum TaskBlockedReason {
  WAITING_ON_CUSTOMER
  WAITING_ON_DRIVER
  WAITING_ON_VENDOR
  WAITING_ON_MANAGER
  WAITING_ON_GOVERNMENT_DMV
  WAITING_ON_AMAZON
  WAITING_ON_INSURANCE
  TECHNICAL_ISSUE
  OTHER
}

model TaskProject {
  id          String         @id @default(cuid())
  name        String
  description String?
  color       String?        @default("#3b82f6")
  icon        String?        @default("📋")
  companyId   String?
  company     Company?       @relation(fields: [companyId], references: [id])
  isArchived  Boolean        @default(false)
  boards      TaskBoard[]
  cards       TaskCard[]
  activities  TaskActivity[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyId])
}

model TaskBoard {
  id        String      @id @default(cuid())
  projectId String
  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int         @default(0)
  color     String?     @default("#e5e7eb")
  status    TaskStatus?
  cards     TaskCard[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model TaskCard {
  id                      String                  @id @default(cuid())
  projectId               String
  project                 TaskProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boardId                 String
  board                   TaskBoard               @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title                   String
  description             String?                 @db.Text
  order                   Int                     @default(0)
  priority                TaskPriority            @default(MEDIUM)
  status                  TaskStatus              @default(TODO)
  assignedTo              String?
  assigneeUserId          String?
  assigneeUser            User?                   @relation("TaskCardAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  dueDate                 DateTime?
  effort                  Int                     @default(3)
  expectedDurationMinutes Int?
  blockedReason           TaskBlockedReason?
  blockedSince            DateTime?
  blockedNote             String?                 @db.Text
  blockedClearedAt        DateTime?
  labels                  TaskLabel[]
  comments                TaskComment[]
  checklistItems          TaskChecklistItem[]
  attachments             TaskAttachment[]
  mentions                TaskMention[]
  activities              TaskActivity[]
  telegramDeliveries      TelegramDelivery[]
  telegramPendingActions  TelegramPendingAction[]
  telegramUpdateRequests  TelegramUpdateRequest[]
  startDate               DateTime?
  completedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([assigneeUserId])
  @@index([assigneeUserId, dueDate, status])
}

model TaskLabel {
  id        String   @id @default(cuid())
  cardId    String
  card      TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#f3f4f6")
  createdAt DateTime @default(now())
}

model TaskComment {
  id                      String                  @id @default(cuid())
  cardId                  String
  card                    TaskCard                @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author                  String
  authorUserId            String?
  authorUser              User?                   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  content                 String                  @db.Text
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  mentions                TaskMention[]
  telegramUpdateResponses TelegramUpdateRequest[]

  @@index([authorUserId])
}

model TaskChecklistItem {
  id              String   @id @default(cuid())
  cardId          String
  card            TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  content         String
  isCompleted     Boolean  @default(false)
  order           Int      @default(0)
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cardId, order, id])
  @@index([createdByUserId])
}

model TaskActivity {
  id          String                 @id @default(cuid())
  projectId   String
  cardId      String?
  entityType  TaskActivityEntityType
  entityId    String
  entityTitle String?
  action      TaskActivityAction
  actorType   TaskActivityActorType  @default(UNATTRIBUTED)
  actorId     String?
  actorUserId String?
  sourceType  String?
  sourceId    String?
  metadata    Json?
  occurredAt  DateTime               @default(now())
  createdAt   DateTime               @default(now())

  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  card      TaskCard?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  actorUser User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, occurredAt, id])
  @@index([cardId, occurredAt, id])
  @@index([entityType, entityId, occurredAt, id])
  @@index([sourceType, sourceId])
  @@index([occurredAt, id])
  @@index([actorUserId, occurredAt, id])
}

model TaskAttachment {
  id               String   @id @default(cuid())
  cardId           String
  card             TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name             String
  url              String
  size             Int?
  mimeType         String?
  uploadedBy       String
  uploaderUserId   String?
  uploaderUser     User?    @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)
  originalFilename String?
  displayFilename  String?
  storageKey       String?  @unique
  byteSize         Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([cardId, createdAt, id])
  @@index([uploaderUserId])
}

model TaskMention {
  id                   String                @id @default(cuid())
  cardId               String
  card                 TaskCard              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  commentId            String?
  comment              TaskComment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId      String?
  mentionedUser        User?                 @relation("MentionedTaskUser", fields: [mentionedUserId], references: [id], onDelete: SetNull)
  mentionedDisplayName String
  sourceType           TaskMentionSourceType
  createdByUserId      String?
  createdByUser        User?                 @relation("TaskMentionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  createdAt            DateTime              @default(now())

  @@index([cardId, sourceType, createdAt])
  @@index([commentId])
  @@index([mentionedUserId, resolvedAt])
}
