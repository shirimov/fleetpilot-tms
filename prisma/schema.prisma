generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TruckStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TruckImportStatus {
  PREVIEWED
  COMMITTED
}

enum TruckImportRowDisposition {
  NEW
  MATCHED
  CONFLICT
  REJECTED
}

enum CabType {
  DAYCAB
  SLEEPER
  OWNER_OP
}

enum DriverPayType {
  PERCENTAGE
  PER_MILE
  FLAT
}

enum LoadStatus {
  DRAFT
  PLANNED
  ASSIGNED
  DISPATCHED
  PICKED_UP
  PENDING
  IN_TRANSIT
  DELIVERED
  POD_UPLOADED
  INVOICED
  PAID
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum TrailerEquipmentType {
  DRY_VAN
  REEFER
  FLATBED
  STEP_DECK
  POWER_ONLY
  OTHER
}

enum TrailerStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  MAINTENANCE
  OUT_OF_SERVICE
  INACTIVE
}

enum LoadStopType {
  PICKUP
  DELIVERY
}

enum DispatchDocumentType {
  RATE_CONFIRMATION
  BOL
  POD
  RECEIPT
  TRAILER_REGISTRATION
  TRAILER_INSURANCE
  TRAILER_INSPECTION
  OTHER
}

enum LoadActivityAction {
  LOAD_CREATED
  LOAD_UPDATED
  STATUS_CHANGED
  ASSIGNMENT_CHANGED
  STOP_CREATED
  STOP_UPDATED
  STOP_DELETED
  DOCUMENT_ADDED
  DOCUMENT_REMOVED
}

model Company {
  id                         String                      @id @default(cuid())
  name                       String
  dotNumber                  String?
  mcNumber                   String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  trucks                     Truck[]
  loads                      Load[]
  bankAccounts               BankAccount[]
  bankTransactions           BankTransaction[]
  bankTransactionAllocations BankTransactionAllocation[]
  bankCategorizationRules    BankCategorizationRule[]
  taskProjects               TaskProject[]
  memberships                CompanyMembership[]
  activeUsers                User[]                      @relation("ActiveCompany")
  companyDrivers             Driver[]                    @relation("DriverCompany")
  employees                  Employee[]
  employeeSkills             EmployeeSkillDefinition[]
  customers                  Customer[]
  trailers                   Trailer[]
  loadActivities             LoadActivity[]
  telegramUserLinks          TelegramUserLink[]
  telegramLinkTokens         TelegramLinkToken[]
  telegramInboundUpdates     TelegramInboundUpdate[]
  telegramDeliveries         TelegramDelivery[]
  telegramPendingActions     TelegramPendingAction[]
  telegramUpdateRequests     TelegramUpdateRequest[]
  operatingGroupLink         OperatingGroupCompany?
  financialSources           FinancialSource[]
  financialTransactions      FinancialTransaction[]
  financialAllocations       FinancialAllocation[]
  financialExpectations      FinancialExpectation[]
  financialParties           FinancialParty[]
  financialAuditEvents       FinancialAuditEvent[]
  truckImportBatches         TruckImportBatch[]
  truckLifecycleEvents       TruckLifecycleEvent[]
}

enum CompanyMembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  displayName     String
  image           String?
  isActive        Boolean  @default(true)
  activeCompanyId String?
  activeCompany   Company? @relation("ActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authAccounts                   AuthAccount[]
  emailSignInTokens              EmailSignInToken[]
  memberships                    CompanyMembership[]
  taskComments                   TaskComment[]
  taskActivities                 TaskActivity[]
  taskChecklistItems             TaskChecklistItem[]
  taskAttachments                TaskAttachment[]
  assignedTaskCards              TaskCard[]                      @relation("TaskCardAssignee")
  createdTaskCards               TaskCard[]                      @relation("TaskCardCreator")
  archivedTaskCards              TaskCard[]                      @relation("TaskCardArchiver")
  taskMentions                   TaskMention[]                   @relation("MentionedTaskUser")
  createdTaskMentions            TaskMention[]                   @relation("TaskMentionCreator")
  loadActivities                 LoadActivity[]
  uploadedLoadDocuments          LoadDocument[]
  uploadedTrailerDocuments       TrailerDocument[]
  telegramUserLinks              TelegramUserLink[]
  telegramLinkTokens             TelegramLinkToken[]
  telegramDeliveries             TelegramDelivery[]
  telegramPendingActions         TelegramPendingAction[]         @relation("TelegramPendingActionUser")
  requestedTelegramUpdates       TelegramUpdateRequest[]         @relation("TelegramUpdateRequester")
  assignedTelegramUpdates        TelegramUpdateRequest[]         @relation("TelegramUpdateAssignee")
  employeeProfile                Employee?
  operatingGroupMemberships      OperatingGroupMembership[]
  importedFinancialStatements    FinancialStatement[]            @relation("FinancialStatementImporter")
  createdFinancialTransactions   FinancialTransaction[]          @relation("FinancialTransactionCreator")
  reviewedFinancialTransactions  FinancialTransaction[]          @relation("FinancialTransactionReviewer")
  waivedFinancialTransactions    FinancialTransaction[]          @relation("FinancialTransactionWaiver")
  matchedFinancialEvidence       FinancialTransactionEvidence[]  @relation("FinancialEvidenceMatcher")
  createdFinancialExpectations   FinancialExpectation[]          @relation("FinancialExpectationCreator")
  financialAuditEvents           FinancialAuditEvent[]           @relation("FinancialAuditActor")
  createdBankConnections         BankAccount[]                   @relation("BankConnectionCreator")
  reviewedBankTransactions       BankTransactionClassification[] @relation("BankTransactionReviewer")
  createdBankCategorizationRules BankCategorizationRule[]        @relation("BankCategorizationRuleCreator")
  updatedBankCategorizationRules BankCategorizationRule[]        @relation("BankCategorizationRuleUpdater")
  createdAdminFeeAgreements      AdminFeeAgreement[]             @relation("AdminFeeAgreementCreator")
  uploadedPilotInvoices          PilotProviderInvoice[]          @relation("PilotInvoiceUploader")
  postedPilotInvoices            PilotProviderInvoice[]          @relation("PilotInvoicePoster")
  resolvedPilotIssues            PilotImportIssue[]              @relation("PilotIssueResolver")
  approvedPilotProductMappings   PilotProductMapping[]           @relation("PilotProductMappingApprover")
  truckImportBatches             TruckImportBatch[]              @relation("TruckImportActor")
  truckLifecycleEvents           TruckLifecycleEvent[]           @relation("TruckLifecycleActor")

  @@index([activeCompanyId])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailSignInToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([expiresAt])
}

model EmailSignInRequest {
  id        String   @id @default(cuid())
  emailHash String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

model CompanyMembership {
  id        String                @id @default(cuid())
  userId    String
  companyId String
  role      CompanyMembershipRole @default(MEMBER)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role])
}

enum TelegramDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRYING
  PERMANENT_FAILURE
  CANCELLED
}

enum TelegramDeliveryType {
  ASSIGNMENT
  UPDATE_REQUEST
  COMMAND_RESPONSE
  CALLBACK_RESPONSE
}

enum TelegramPendingActionType {
  ADD_UPDATE
  START_TASK
  COMPLETE_TASK
  OPEN_TASK
}

enum TelegramUpdateRequestStatus {
  PENDING
  RESPONDED
  EXPIRED
  CANCELLED
}

model TelegramUserLink {
  id               String   @id @default(cuid())
  companyId        String
  userId           String
  telegramUserId   BigInt   @unique
  telegramChatId   BigInt   @unique
  telegramUsername String?
  verifiedAt       DateTime
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId, enabled])
  @@index([userId, enabled])
}

model TelegramLinkToken {
  id         String    @id @default(cuid())
  companyId  String
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, expiresAt])
  @@index([userId, consumedAt, expiresAt])
}

model TelegramInboundUpdate {
  id               String    @id @default(cuid())
  companyId        String?
  telegramUserId   BigInt?
  telegramChatId   BigInt?
  telegramUpdateId BigInt    @unique
  kind             String
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([telegramUserId, createdAt])
}

model TelegramDelivery {
  id                String                 @id @default(cuid())
  companyId         String
  userId            String
  taskCardId        String?
  type              TelegramDeliveryType
  telegramChatId    BigInt
  telegramMessageId BigInt?
  payload           Json
  dedupeKey         String?
  status            TelegramDeliveryStatus @default(PENDING)
  attempts          Int                    @default(0)
  nextAttemptAt     DateTime               @default(now())
  lastError         String?
  createdAt         DateTime               @default(now())
  deliveredAt       DateTime?
  updatedAt         DateTime               @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskCard TaskCard? @relation(fields: [taskCardId], references: [id], onDelete: SetNull)

  @@unique([dedupeKey])
  @@index([companyId, status, nextAttemptAt, createdAt])
  @@index([userId, status, nextAttemptAt])
  @@index([taskCardId, type, createdAt])
}

model TelegramUpdateRequest {
  id                String                      @id @default(cuid())
  companyId         String
  taskCardId        String
  requestedByUserId String
  assigneeUserId    String
  status            TelegramUpdateRequestStatus @default(PENDING)
  telegramMessageId BigInt?
  expiresAt         DateTime
  respondedAt       DateTime?
  responseCommentId String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskCard        TaskCard                @relation(fields: [taskCardId], references: [id], onDelete: Cascade)
  requestedByUser User                    @relation("TelegramUpdateRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  assigneeUser    User                    @relation("TelegramUpdateAssignee", fields: [assigneeUserId], references: [id], onDelete: Cascade)
  responseComment TaskComment?            @relation(fields: [responseCommentId], references: [id], onDelete: SetNull)
  pendingActions  TelegramPendingAction[]

  @@index([companyId, assigneeUserId, status, createdAt])
  @@index([taskCardId, status, createdAt])
  @@index([responseCommentId])
}

model TelegramPendingAction {
  id                      String                    @id @default(cuid())
  companyId               String
  userId                  String
  taskCardId              String?
  telegramChatId          BigInt
  type                    TelegramPendingActionType
  requestedByUserId       String?
  telegramMessageId       BigInt?
  telegramUpdateRequestId String?
  expiresAt               DateTime
  consumedAt              DateTime?
  invalidatedAt           DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User                   @relation("TelegramPendingActionUser", fields: [userId], references: [id], onDelete: Cascade)
  taskCard      TaskCard?              @relation(fields: [taskCardId], references: [id], onDelete: Cascade)
  updateRequest TelegramUpdateRequest? @relation(fields: [telegramUpdateRequestId], references: [id], onDelete: SetNull)

  @@index([companyId, userId, type, expiresAt])
  @@index([telegramChatId, type, expiresAt])
  @@index([taskCardId, type, expiresAt])
}

model Truck {
  id                         String                      @id @default(cuid())
  unitNumber                 String
  unitNumberNormalized       String?
  vin                        String?
  vinNormalized              String?                     @unique
  year                       Int?
  make                       String?
  model                      String?
  status                     TruckStatus                 @default(ACTIVE)
  companyId                  String
  company                    Company                     @relation(fields: [companyId], references: [id])
  cabType                    CabType                     @default(SLEEPER)
  isOwnerOp                  Boolean                     @default(false)
  ownerName                  String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  drivers                    Driver[]
  loads                      Load[]
  settlements                Settlement[]
  truckInspections           TruckInspection[]
  financialAllocations       FinancialAllocation[]
  bankTransactionAllocations BankTransactionAllocation[]
  financialExpectations      FinancialExpectation[]
  adminFeeAgreements         AdminFeeAgreement[]
  pilotFuelingEvents         PilotFuelingEvent[]
  importRows                 TruckImportRow[]
  bankCategorizationRules    BankCategorizationRule[]

  @@unique([companyId, unitNumberNormalized])
  @@index([companyId, status, unitNumber])
}

model TruckImportBatch {
  id             String            @id @default(cuid())
  companyId      String
  actorUserId    String
  originalName   String
  checksumSha256 String
  status         TruckImportStatus @default(PREVIEWED)
  totalRows      Int
  newRows        Int
  matchedRows    Int
  conflictRows   Int
  rejectedRows   Int
  committedAt    DateTime?
  createdAt      DateTime          @default(now())
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor          User              @relation("TruckImportActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  rows           TruckImportRow[]

  @@unique([companyId, checksumSha256])
  @@index([companyId, createdAt])
}

model TruckImportRow {
  id                   String                    @id @default(cuid())
  batchId              String
  rowNumber            Int
  disposition          TruckImportRowDisposition
  unitNumber           String?
  unitNumberNormalized String?
  vin                  String?
  vinNormalized        String?
  status               TruckStatus?
  year                 Int?
  make                 String?
  model                String?
  existingTruckId      String?
  message              String?
  createdTruckId       String?
  batch                TruckImportBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  existingTruck        Truck?                    @relation(fields: [existingTruckId], references: [id], onDelete: Restrict)

  @@unique([batchId, rowNumber])
  @@index([batchId, disposition])
  @@index([existingTruckId])
}

model TruckLifecycleEvent {
  id             String   @id @default(cuid())
  companyId      String
  actorUserId    String
  truckReference String
  unitNumber     String
  action         String
  before         Json?
  after          Json?
  metadata       Json?
  occurredAt     DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor          User     @relation("TruckLifecycleActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([companyId, occurredAt, id])
  @@index([truckReference, occurredAt, id])
  @@index([actorUserId, occurredAt, id])
}

model Customer {
  id                    String                 @id @default(cuid())
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  status                CustomerStatus         @default(ACTIVE)
  mcNumber              String?
  dotNumber             String?
  email                 String?
  phone                 String?
  notes                 String?                @db.Text
  contacts              CustomerContact[]
  loads                 Load[]
  financialAllocations  FinancialAllocation[]
  financialExpectations FinancialExpectation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  financialTransactions FinancialTransaction[]

  @@unique([companyId, name])
  @@index([companyId, status, name])
}

model CustomerContact {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  title      String?
  email      String?
  phone      String?
  notes      String?    @db.Text
  loadStops  LoadStop[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, name])
}

model Trailer {
  id                         String                      @id @default(cuid())
  companyId                  String
  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitNumber                 String
  equipmentType              TrailerEquipmentType        @default(DRY_VAN)
  status                     TrailerStatus               @default(AVAILABLE)
  vin                        String?
  plate                      String?
  state                      String?
  notes                      String?                     @db.Text
  loads                      Load[]
  documents                  TrailerDocument[]
  financialAllocations       FinancialAllocation[]
  bankTransactionAllocations BankTransactionAllocation[]
  bankCategorizationRules    BankCategorizationRule[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@unique([companyId, unitNumber])
  @@index([companyId, status, equipmentType])
}

model Driver {
  id                         String                      @id @default(cuid())
  companyId                  String?
  company                    Company?                    @relation("DriverCompany", fields: [companyId], references: [id])
  firstName                  String
  lastName                   String
  phone                      String?
  email                      String?
  licenseNum                 String?
  payType                    DriverPayType               @default(PERCENTAGE)
  payRate                    Float
  truckId                    String?
  truck                      Truck?                      @relation(fields: [truckId], references: [id])
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  loads                      Load[]
  settlements                Settlement[]
  driverOrientations         DriverOrientation[]
  financialAllocations       FinancialAllocation[]
  bankTransactionAllocations BankTransactionAllocation[]
  bankCategorizationRules    BankCategorizationRule[]

  @@index([companyId])
}

model Load {
  id                    String                 @id @default(cuid())
  loadNumber            String                 @unique
  referenceNum          String?
  status                LoadStatus             @default(DRAFT)
  origin                String
  destination           String
  pickupDate            DateTime?
  deliveryDate          DateTime?
  miles                 Float?
  rate                  Float
  fuelSurcharge         Float?                 @default(0)
  truckId               String?
  truck                 Truck?                 @relation(fields: [truckId], references: [id])
  driverId              String?
  driver                Driver?                @relation(fields: [driverId], references: [id])
  trailerId             String?
  trailer               Trailer?               @relation(fields: [trailerId], references: [id])
  customerId            String?
  customer              Customer?              @relation(fields: [customerId], references: [id])
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id])
  notes                 String?                @db.Text
  invoiceNumber         String?
  stops                 LoadStop[]
  documents             LoadDocument[]
  activities            LoadActivity[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  settlement            Settlement?
  financialAllocations  FinancialAllocation[]
  financialExpectations FinancialExpectation[]

  @@index([companyId, status, pickupDate])
  @@index([companyId, truckId, pickupDate, deliveryDate])
  @@index([companyId, driverId, pickupDate, deliveryDate])
  @@index([companyId, trailerId, pickupDate, deliveryDate])
  @@index([customerId])
}

model LoadStop {
  id               String           @id @default(cuid())
  loadId           String
  load             Load             @relation(fields: [loadId], references: [id], onDelete: Cascade)
  type             LoadStopType
  order            Int
  facilityName     String
  addressLine1     String?
  addressLine2     String?
  city             String
  state            String?
  postalCode       String?
  country          String           @default("US")
  contactId        String?
  contact          CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName      String?
  contactPhone     String?
  appointmentStart DateTime?
  appointmentEnd   DateTime?
  arrivedAt        DateTime?
  departedAt       DateTime?
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([loadId, order])
  @@index([loadId, type, order])
  @@index([contactId])
}

model LoadDocument {
  id               String               @id @default(cuid())
  loadId           String
  load             Load                 @relation(fields: [loadId], references: [id], onDelete: Cascade)
  type             DispatchDocumentType
  originalFilename String
  displayFilename  String
  mimeType         String
  byteSize         Int
  storageKey       String               @unique
  uploaderUserId   String?
  uploaderUser     User?                @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@index([loadId, type, createdAt])
  @@index([uploaderUserId])
}

model TrailerDocument {
  id               String               @id @default(cuid())
  trailerId        String
  trailer          Trailer              @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  type             DispatchDocumentType
  originalFilename String
  displayFilename  String
  mimeType         String
  byteSize         Int
  storageKey       String               @unique
  expiresAt        DateTime?
  uploaderUserId   String?
  uploaderUser     User?                @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@index([trailerId, type, createdAt])
  @@index([uploaderUserId])
}

model LoadActivity {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  loadId      String?
  load        Load?              @relation(fields: [loadId], references: [id], onDelete: SetNull)
  loadNumber  String
  action      LoadActivityAction
  actorUserId String?
  actorUser   User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata    Json?
  occurredAt  DateTime           @default(now())
  createdAt   DateTime           @default(now())

  @@index([companyId, occurredAt, id])
  @@index([loadId, occurredAt, id])
  @@index([actorUserId, occurredAt, id])
}

model Settlement {
  id              String    @id @default(cuid())
  weekEnding      DateTime
  truckId         String
  truck           Truck     @relation(fields: [truckId], references: [id])
  driverId        String?
  driver          Driver?   @relation(fields: [driverId], references: [id])
  loadId          String?   @unique
  load            Load?     @relation(fields: [loadId], references: [id])
  grossRevenue    Float
  driverPay       Float
  fuelDeduction   Float     @default(0)
  otherDeductions Float     @default(0)
  netPay          Float
  isPaid          Boolean   @default(false)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TruckInspection {
  id             String   @id @default(cuid())
  truckId        String
  truck          Truck    @relation(fields: [truckId], references: [id])
  inspectedBy    String
  inspectedAt    DateTime @default(now())
  phase1         Json
  phase2         Json
  phase3         Json
  currentMileage Int?
  notes          String?
  passed         Boolean  @default(true)
  photos         Json?
  createdAt      DateTime @default(now())
}

enum BankConnectionProvider {
  PLAID
  FILE_IMPORT
  OTHER
}

enum BankConnectionStatus {
  ACTIVE
  ERROR
  REQUIRES_REAUTH
  DISABLED
  REVOKED
}

enum BankTransactionLifecycle {
  PENDING
  POSTED
  REMOVED
}

enum BankTransactionReviewStatus {
  UNREVIEWED
  SUGGESTED
  REVIEWED
  NEEDS_REVIEW
  IGNORED
}

enum BankWebhookEventStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  IGNORED
}

enum BankClassificationScope {
  COMPANY_LEVEL
  ENTITY_ALLOCATED
}

enum BankReconciliationStatus {
  NOT_APPLICABLE
  UNMATCHED
  PARTIALLY_MATCHED
  MATCHED
  DISCREPANCY
}

// Legacy table name retained to evolve the existing Plaid connection safely.
model BankAccount {
  id                     String                      @id @default(cuid())
  companyId              String?
  company                Company?                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  provider               BankConnectionProvider      @default(PLAID)
  externalConnectionId   String?
  plaidItemId            String?                     @unique
  plaidAccessToken       String?                     @db.Text
  accessTokenCiphertext  String?                     @db.Text
  institutionId          String?
  institutionName        String?
  status                 BankConnectionStatus        @default(ACTIVE)
  consentMetadata        Json?
  syncCursor             String?
  lastSync               DateTime?
  lastSyncAttemptAt      DateTime?
  lastSyncErrorCode      String?
  lastSyncErrorMessage   String?
  disabledAt             DateTime?
  revokedAt              DateTime?
  createdByUserId        String?
  createdBy              User?                       @relation("BankConnectionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  accounts               BankSubAccount[]
  transactions           BankTransaction[]
  transactionExternalIds BankTransactionExternalId[]
  categorizationRules    BankCategorizationRule[]
  webhookEvents          BankProviderWebhookEvent[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([companyId, provider, externalConnectionId])
  @@index([companyId, status])
  @@index([createdByUserId])
}

model BankProviderWebhookEvent {
  id              String                 @id @default(cuid())
  bankAccountId   String
  provider        BankConnectionProvider
  eventHashSha256 String
  webhookType     String
  webhookCode     String
  status          BankWebhookEventStatus @default(QUEUED)
  receivedAt      DateTime               @default(now())
  bankAccount     BankAccount            @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@unique([provider, eventHashSha256])
  @@index([bankAccountId, status, receivedAt])
}

model BankSubAccount {
  id                    String            @id @default(cuid())
  bankAccountId         String
  bankAccount           BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  externalAccountId     String?
  plaidAccountId        String?           @unique
  institutionName       String?
  name                  String
  officialName          String?
  type                  String
  subtype               String?
  mask                  String?
  currency              String            @default("USD")
  currentBalance        Float?
  availableBalance      Float?
  currentBalanceMinor   BigInt?
  availableBalanceMinor BigInt?
  isActive              Boolean           @default(true)
  lastSyncedAt          DateTime?
  transactions          BankTransaction[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([bankAccountId, externalAccountId])
  @@index([bankAccountId, isActive])
}

model BankTransaction {
  id                           String                         @id @default(cuid())
  bankAccountId                String
  bankAccount                  BankAccount                    @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  subAccountId                 String?
  subAccount                   BankSubAccount?                @relation(fields: [subAccountId], references: [id], onDelete: Restrict)
  companyId                    String?
  company                      Company?                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plaidTransactionId           String?                        @unique
  providerTransactionId        String?
  providerPendingTransactionId String?
  date                         DateTime
  authorizedDate               DateTime?                      @db.Date
  postedDate                   DateTime?                      @db.Date
  amount                       Float
  amountMinor                  BigInt?
  providerAmountText           String?
  currency                     String                         @default("USD")
  direction                    FinancialDirection?
  name                         String
  originalDescription          String?
  merchantName                 String?
  category                     String?
  subCategory                  String?
  providerCategory             Json?
  pending                      Boolean                        @default(false)
  lifecycle                    BankTransactionLifecycle       @default(POSTED)
  checkNumber                  String?
  referenceNumber              String?
  location                     Json?
  sourceMetadata               Json?
  sourceHashSha256             String?
  firstSeenAt                  DateTime                       @default(now())
  lastSeenAt                   DateTime                       @default(now())
  removedAt                    DateTime?
  notes                        String?
  externalIds                  BankTransactionExternalId[]
  classification               BankTransactionClassification?
  allocations                  BankTransactionAllocation[]
  auditEvents                  FinancialAuditEvent[]
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt

  @@unique([bankAccountId, providerTransactionId])
  @@index([companyId, date, id])
  @@index([subAccountId, date, id])
  @@index([lifecycle, date, id])
  @@index([sourceHashSha256])
}

model BankTransactionExternalId {
  id                String          @id @default(cuid())
  bankAccountId     String
  bankTransactionId String
  externalId        String
  isCurrent         Boolean         @default(true)
  firstSeenAt       DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  bankAccount       BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)

  @@unique([bankAccountId, externalId])
  @@index([bankTransactionId, isCurrent])
}

model BankTransactionClassification {
  id                   String                      @id @default(cuid())
  bankTransactionId    String                      @unique
  categoryId           String?
  scope                BankClassificationScope     @default(COMPANY_LEVEL)
  reviewStatus         BankTransactionReviewStatus @default(UNREVIEWED)
  reconciliationStatus BankReconciliationStatus    @default(UNMATCHED)
  notes                String?                     @db.Text
  suggestionReason     String?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  bankTransaction      BankTransaction             @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  category             FinancialCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewedBy           User?                       @relation("BankTransactionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([reviewStatus, updatedAt])
  @@index([categoryId, reviewStatus])
  @@index([reconciliationStatus, updatedAt], map: "BankTxClass_reconciliation_updated_idx")
}

model BankTransactionAllocation {
  id                String            @id @default(cuid())
  bankTransactionId String
  amountMinor       BigInt
  categoryId        String
  companyId         String
  truckId           String?
  trailerId         String?
  driverId          String?
  partyId           String?
  memo              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bankTransaction   BankTransaction   @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  category          FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  truck             Truck?            @relation(fields: [truckId], references: [id], onDelete: Restrict)
  trailer           Trailer?          @relation(fields: [trailerId], references: [id], onDelete: Restrict)
  driver            Driver?           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  party             FinancialParty?   @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([bankTransactionId])
  @@index([categoryId])
  @@index([companyId])
  @@index([truckId])
  @@index([trailerId])
  @@index([driverId])
  @@index([partyId])
}

model BankCategorizationRule {
  id                            String                  @id @default(cuid())
